# @defaultSensitive=false @defaultRequired=infer
# @generateTsTypes(path=env.d.ts)
# ---

# Deploy to www.glass.no without the preview login, instead of ny.glass.no behind it
# @type=boolean
LIVE=false

# Extra people, besides @glass.no addresses, who may open ny.glass.no before launch
# @example="first@example.com,second@example.com"
PREVIEW_EMAILS=

# Also post contact form enquiries to this address, on top of the email to post@glass.no
# @sensitive @type=url
CONTACT_WEBHOOK_URL=

# Local dev only; production gets its own key from alchemy.run.ts
# @sensitive @type=string(startsWith=emdash_enc_v1_)
# @docs(https://docs.emdashcms.com)
EMDASH_ENCRYPTION_KEY=

# Local EmDash used by the migration scripts
# @type=url
EMDASH_URL=http://localhost:4330
