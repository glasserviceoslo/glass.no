---
import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import { createPublicPageContext } from "emdash/page";
import { EmDashBodyEnd, EmDashBodyStart, EmDashHead } from "emdash/ui";
import BlockEditing from "../components/BlockEditing.astro";
import BookingPopup from "../components/BookingPopup.astro";
import CookieConsent from "../components/CookieConsent.astro";
import Header from "../components/Header.astro";
import SocialLinks from "../components/SocialLinks.astro";
import { resolveSiteIdentity } from "../utils/site";
import "@fontsource-variable/hanken-grotesk";
import "../styles/site.css";

interface Props {
	title?: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	pageType?: "website" | "article";
	content?: { collection: string; id: string; slug?: string | null };
	publishedAt?: Date | string | null;
}

const { title, pageTitle, description, image, canonical, robots, pageType = "website", content, publishedAt } = Astro.props;

const [settings, menu] = await Promise.all([getSiteSettingsWithCacheHint(), getMenuWithCacheHint("primary")]);
if (Astro.cache?.enabled) {
	Astro.cache.set(settings.cacheHint);
	Astro.cache.set(menu.cacheHint);
}

const { siteTitle, siteTagline, siteLogo, titleSeparator } = resolveSiteIdentity(settings.data);
const fullTitle = title ? (title.toLowerCase().includes(siteTitle.toLowerCase()) ? title : `${title} ${titleSeparator} ${siteTitle}`) : siteTitle;
const items = menu.data?.items ?? [];
const origin = Astro.site?.origin ?? Astro.url.origin;
const sameAs = Object.values(settings.data?.social ?? {}).filter((url): url is string => typeof url === "string" && url.startsWith("https://"));
const business =
	Astro.url.pathname === "/"
		? {
				"@context": "https://schema.org",
				"@type": "HomeAndConstructionBusiness",
				"@id": `${origin}/#organization`,
				name: siteTitle,
				legalName: "Glass-Service Svendsen og Sønn AS",
				url: `${origin}/`,
				...(siteLogo ? { logo: new URL(siteLogo.url, origin).toString() } : {}),
				...(image ? { image } : {}),
				telephone: "+47 91 58 49 40",
				email: "post@glass.no",
				foundingDate: "1889",
				address: { "@type": "PostalAddress", streetAddress: "Pilestredet 41A", postalCode: "0166", addressLocality: "Oslo", addressCountry: "NO" },
				geo: { "@type": "GeoCoordinates", latitude: 59.920236, longitude: 10.734451 },
				openingHoursSpecification: [{ "@type": "OpeningHoursSpecification", dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"], opens: "08:00", closes: "17:00" }],
				areaServed: "Oslo",
				...(sameAs.length ? { sameAs } : {}),
			}
		: null;

type Crumb = { name: string; url: string };
const trim = (url: string) => url.replace(/\/+$/, "");
const pathOf = (url: string) => trim(new URL(url, origin).pathname);
const here = trim(Astro.url.pathname);
const trailTo = (nodes: typeof items, path: Crumb[]): Crumb[] | null => {
	for (const node of nodes) {
		const crumbs = node.url ? [...path, { name: node.label, url: `${pathOf(node.url)}/` }] : path;
		if (node.url && pathOf(node.url) === here) return crumbs;
		const found = trailTo(node.children, crumbs);
		if (found) return found;
	}
	return null;
};
const homeCrumb = { name: "Hjem", url: "/" };
const currentCrumb = { name: pageTitle ?? title ?? siteTitle, url: Astro.url.pathname };
const menuTrail = here ? trailTo(items, []) : null;
const trail = !here
	? []
	: menuTrail
		? [homeCrumb, ...menuTrail.filter((crumb) => !["", "/hjem"].includes(pathOf(crumb.url)))]
		: pageType === "article"
			? [homeCrumb, { name: "Blogg", url: "/blogg/" }, currentCrumb]
			: [homeCrumb, currentCrumb];
const breadcrumbs =
	trail.length > 1
		? {
				"@context": "https://schema.org",
				"@type": "BreadcrumbList",
				itemListElement: trail.map((crumb, index) => ({
					"@type": "ListItem",
					position: index + 1,
					name: crumb.name,
					item: new URL(crumb.url, origin).toString(),
				})),
			}
		: null;
const isoDate = (value: Date | string | null | undefined) => (value ? new Date(value).toISOString() : null);

const page = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType,
	title: fullTitle,
	pageTitle: pageTitle ?? title ?? siteTitle,
	description: description || siteTagline || undefined,
	canonical: canonical ?? `${origin}${Astro.url.pathname}`,
	image,
	content,
	seo: { ogImage: image, robots },
	articleMeta: pageType === "article" ? { publishedTime: isoDate(publishedAt) } : undefined,
	breadcrumbs: trail.map((crumb) => ({ name: crumb.name, url: new URL(crumb.url, origin).toString() })),
	siteName: siteTitle,
	siteUrl: origin,
});
---

<!doctype html>
<html lang="nb" data-type="service" data-radius="soft" data-buttons="tonal" data-motion>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<title>{fullTitle}</title>
		<EmDashHead page={page} />
		{business && <script type="application/ld+json" set:html={JSON.stringify(business)} />}
		{breadcrumbs && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbs)} />}
		<meta name="site-kind" content="other" />
		<meta name="page-type" content="service" />
		<meta name="theme-color" content="#f8f9fa" />
		<link rel="stylesheet" href="/assets/system.css" />
		<link rel="stylesheet" href="/assets/ui/cards.css" />
		<link rel="stylesheet" href="/assets/motion/motion.css" />
		<link rel="stylesheet" href="/assets/layout/layout.css" />
		<link rel="stylesheet" href="/assets/icons/icon.css" />
		<style is:inline>
			:root {
				--p-bg: #f8f9fa; --p-surface: #e9ebf0; --p-ink: #040037; --p-muted: #556186;
				--p-accent: #ed4c4c; --p-accent-ink: #ffffff; --p-action: #d93636; --p-action-ink: #ffffff;
				--p-inv-bg: #040037; --p-inv-surface: #0b1144; --p-inv-ink: #f8f9fa; --p-inv-muted: #8b94ae;
				--p-inv-accent: #ed4c4c; --p-inv-accent-ink: #ffffff; --p-inv-action: #d93636; --p-inv-action-ink: #ffffff;
				--font-display: "Hanken Grotesk Variable", system-ui, sans-serif;
				--font-text: "Hanken Grotesk Variable", system-ui, sans-serif;
				--display-weight: 400;
				--display-tracking: -0.03em;
				--display-tracking-xl: -0.038em;
			}
		</style>
		<script is:inline>document.documentElement.classList.add("m-enter");setTimeout(()=>document.documentElement.classList.add("m-enter-done"),700)</script>
	</head>
	<body>
		<EmDashBodyStart page={page} />
		<Header items={items} logo={siteLogo} siteTitle={siteTitle} />
		<main id="top" data-entry={content ? JSON.stringify({ collection: content.collection, id: content.id }) : undefined}>
			<slot />
		</main>
		<footer class="site-footer" id="contact">
			<div class="wrap">
				<div class="site-footer__main">
					<a class="site-footer__logo" href="/" aria-label={`${siteTitle}, forsiden`}>
						<img src="/images/logo-white.png" alt="" width="2560" height="709" />
					</a>
					<ul class="site-footer__contact">
						<li><a href="tel:+4791584940">+47 91 58 49 40</a></li>
						<li><a href="https://www.google.com/maps/search/?api=1&amp;query=Pilestredet%2041A%2C%20Oslo" target="_blank" rel="noopener">Pilestredet 41A</a></li>
						<li>Man - Fre 08:00-17:00</li>
					</ul>
					<div class="site-footer__actions">
						<SocialLinks social={settings.data?.social} class="site-footer__social" />
					</div>
				</div>
				<div class="site-footer__legal">
					<span>&copy; {new Date().getFullYear()} Glass-Service Svendsen og Sønn AS</span>
					<span class="site-footer__links">
						<a href="/privacy-policy/">Personvern</a>
						<button type="button" data-consent-open>Cookie-innstillinger</button>
					</span>
				</div>
			</div>
		</footer>
		<BookingPopup />
		<BlockEditing />
		<CookieConsent logo={siteLogo} siteTitle={siteTitle} />
		<EmDashBodyEnd page={page} />
		<script is:inline type="module" src="/assets/system.js"></script>
		<script is:inline type="module" src="/assets/motion/motion.js"></script>
		<script is:inline type="module" src="/assets/layout/layout.js"></script>
		<script>
			const motion = window.matchMedia("(prefers-reduced-motion: no-preference)");
			const running = new WeakMap<HTMLDetailsElement, Animation>();

			const slide = (details: HTMLDetailsElement, summary: HTMLElement, opening: boolean) => {
				running.get(details)?.cancel();
				const from = details.getBoundingClientRect().height;
				if (opening) details.open = true;
				const to = opening ? details.scrollHeight : summary.getBoundingClientRect().height;
				details.style.overflow = "clip";
				const animation = details.animate(
					{ height: [`${from}px`, `${to}px`] },
					{ duration: opening ? 280 : 200, easing: opening ? "cubic-bezier(0.25, 1, 0.5, 1)" : "cubic-bezier(0.5, 0, 0.75, 0)" },
				);
				running.set(details, animation);
				animation.finished
					.then(() => {
						running.delete(details);
						if (!opening) details.open = false;
						details.style.overflow = "";
					})
					.catch(() => {});
			};

			document.addEventListener("click", (event) => {
				const summary = (event.target as HTMLElement).closest<HTMLElement>("main details > summary");
				const details = summary?.parentElement as HTMLDetailsElement | undefined;
				if (!summary || !details || details.closest(".faq") || !motion.matches) return;
				event.preventDefault();
				const opening = (details.dataset.target ?? (details.open ? "open" : "closed")) === "closed";
				details.dataset.target = opening ? "open" : "closed";
				slide(details, summary, opening);
			});
		</script>
	</body>
</html>
