---
import { env } from "cloudflare:workers";

interface Props {
	id: string;
}

const { id } = Astro.props;
const siteKey = (env as { TURNSTILE_SITE_KEY?: string }).TURNSTILE_SITE_KEY;
const fields = [
	{ name: "fornavn", label: "Navn", type: "text", autocomplete: "given-name", error: "Skriv navnet ditt." },
	{ name: "etternavn", label: "Etternavn", type: "text", autocomplete: "family-name", error: "Skriv etternavnet ditt." },
	{ name: "epost", label: "E-post", type: "email", autocomplete: "email", inputmode: "email", error: "Skriv en e-postadresse med @, som navn@eksempel.no." },
	{
		name: "telefon",
		label: "Telefon",
		type: "tel",
		autocomplete: "tel",
		inputmode: "tel",
		value: "+47",
		pattern: "[+]?[0-9 ]{8,}",
		error: "Skriv telefonnummeret ditt, minst åtte siffer.",
	},
	{ name: "adresse", label: "Adresse", type: "text", autocomplete: "street-address", error: "Skriv adressen der jobben skal gjøres.", full: true },
];
const sent =
	"Takk for din henvendelse! Vi har mottatt meldingen din og setter stor pris på at du tok deg tid til å kontakte oss. Vårt team vil gjennomgå henvendelsen din og komme tilbake til deg så snart som mulig.";
const failed = "Meldingen ble ikke sendt. Det du skrev er tatt vare på. Prøv igjen, eller ring oss på 91 58 49 40.";
const result = Astro.url.searchParams.get("skjema");
const initialStatus = result === "sendt" ? sent : result === "feil" ? failed : "";
---

<form
	class="form"
	method="post"
	action="/api/kontakt"
	data-endpoint="/api/kontakt"
	data-sent={sent}
	data-failed={failed}
	data-sending="Sender …"
	data-fix="Rett {n} felt før du sender."
	novalidate
>
	{
		fields.map((field) => (
			<div class:list={["field", { "field--full": field.full }]}>
				<label for={`${id}-${field.name}`}>{field.label}</label>
				<input
					id={`${id}-${field.name}`}
					name={field.name}
					type={field.type}
					autocomplete={field.autocomplete}
					inputmode={field.inputmode as never}
					value={field.value}
					pattern={field.pattern}
					required
					aria-describedby={`${id}-${field.name}-err`}
				/>
				<p class="field__error" id={`${id}-${field.name}-err`} hidden>
					{field.error}
				</p>
			</div>
		))
	}
	<div class="field field--full">
		<label for={`${id}-melding`}>Melding</label>
		<textarea id={`${id}-melding`} name="melding" rows="5" required aria-describedby={`${id}-melding-err`}></textarea>
		<p class="field__error" id={`${id}-melding-err`} hidden>Skriv hva du trenger hjelp med.</p>
	</div>
	<div class="field field--trap" aria-hidden="true">
		<label for={`${id}-nettsted`}>Nettsted</label>
		<input id={`${id}-nettsted`} name="nettsted" type="text" tabindex="-1" autocomplete="off" />
	</div>
	{siteKey && <div class="cf-turnstile field--full" data-sitekey={siteKey} data-language="nb" data-appearance="interaction-only" data-theme="light" data-size="flexible"></div>}
	<div class="btn-row"><button class="btn btn--primary" type="submit">Send melding</button></div>
	<p class="form__status" role="status" data-form-status>{initialStatus}</p>
</form>

<script>
	const widgets = document.querySelectorAll<HTMLElement>(".cf-turnstile");
	if (widgets.length && !document.querySelector('script[src^="https://challenges.cloudflare.com/turnstile/"]')) {
		const script = document.createElement("script");
		script.src = "https://challenges.cloudflare.com/turnstile/v0/api.js";
		script.async = true;
		script.defer = true;
		document.head.append(script);
	}
	widgets.forEach((widget) => {
		const form = widget.closest("form")!;
		const status = form.querySelector("[data-form-status]")!;
		new MutationObserver(() => {
			const text = status.textContent?.trim();
			if (text === form.dataset.sent || text === form.dataset.failed) (window as unknown as { turnstile?: { reset(el: Element): void } }).turnstile?.reset(widget);
		}).observe(status, { childList: true, characterData: true, subtree: true });
	});
</script>

<style>
	.field--trap {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
	}

	.cf-turnstile:empty {
		display: none;
	}
</style>
