---
interface Props {
	logo: { url: string; width?: number; height?: number } | null;
	siteTitle: string;
}

const { logo, siteTitle } = Astro.props;
const categories = [
	{ id: "necessary", label: "Nødvendig", locked: true },
	{ id: "kart", label: "Kart", locked: false },
	{ id: "statistikk", label: "Statistikk", locked: false, analytics: true },
];
---

<section class="consent" role="dialog" aria-labelledby="consent-title" aria-describedby="consent-text" hidden>
	<header class="consent__head">
		{logo ? <img src={logo.url} alt={siteTitle} width={logo.width} height={logo.height} /> : <strong>{siteTitle}</strong>}
		<button class="consent__close" type="button" aria-label="Lukk" data-consent-close hidden>
			<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7 7 10 10M17 7 7 17" /></svg>
		</button>
	</header>
	<div class="consent__body">
		<h2 id="consent-title">Denne nettsiden anvender cookies</h2>
		<p id="consent-text">
			Vi bruker nødvendige informasjonskapsler for at nettstedet skal fungere. Med ditt samtykke viser vi også kart fra Google Maps<span data-analytics hidden> og måler besøk med Google Analytics</span>. Disse tjenestene setter egne informasjonskapsler. <a href="/privacy-policy/">Personvern</a>
		</p>
	</div>
	<fieldset class="consent__choices">
		<legend>Samtykkevalg</legend>
		{
			categories.map((category) => (
				<label class="consent__choice" data-analytics={category.analytics ? "" : undefined} hidden={category.analytics}>
					<span>{category.label}</span>
					<input type="checkbox" role="switch" value={category.id} checked={category.locked} disabled={category.locked} />
				</label>
			))
		}
	</fieldset>
	<div class="consent__actions">
		<button type="button" data-consent="none">Ikke Tillat</button>
		<button type="button" data-consent="selection">Tillat Utvalg</button>
		<button type="button" data-consent="all" class="consent__primary">Tillat Alle</button>
	</div>
</section>

<script>
	import * as CookieConsent from "vanilla-cookieconsent";

	const banner = document.querySelector<HTMLElement>(".consent")!;
	if (document.querySelector('script[data-category="statistikk"]')) banner.querySelectorAll<HTMLElement>("[data-analytics]").forEach((element) => (element.hidden = false));
	const switches = [...banner.querySelectorAll<HTMLInputElement>(".consent__choice:not([hidden]) input:not(:disabled)")];
	const close = banner.querySelector<HTMLButtonElement>("[data-consent-close]")!;

	const open = (reopened: boolean) => {
		const accepted = CookieConsent.getUserPreferences().acceptedCategories;
		switches.forEach((input) => (input.checked = accepted.includes(input.value)));
		close.hidden = !reopened;
		banner.hidden = false;
		requestAnimationFrame(() => banner.classList.add("is-open"));
	};

	const hide = () => {
		banner.classList.remove("is-open");
		banner.hidden = true;
	};

	banner.querySelectorAll<HTMLButtonElement>("[data-consent]").forEach((button) =>
		button.addEventListener("click", () => {
			const choice = button.dataset.consent;
			CookieConsent.acceptCategory(choice === "all" ? "all" : choice === "none" ? [] : switches.filter((input) => input.checked).map((input) => input.value));
			hide();
		}),
	);
	close.addEventListener("click", hide);
	document.addEventListener("click", (event) => {
		if ((event.target as HTMLElement).closest("[data-consent-open]")) open(true);
	});

	await CookieConsent.run({
		revision: 1,
		autoShow: false,
		categories: {
			necessary: { enabled: true, readOnly: true },
			kart: {},
			statistikk: { autoClear: { cookies: [{ name: /^_ga/ }], reloadPage: true } },
		},
		language: { default: "nb", translations: { nb: { consentModal: {}, preferencesModal: { sections: [] } } } },
	});
	if (!CookieConsent.validConsent()) open(false);
</script>

<style>
	.consent {
		position: fixed;
		right: clamp(10px, 2vw, 24px);
		bottom: clamp(10px, 2vw, 24px);
		z-index: 70;
		display: grid;
		width: min(30rem, calc(100% - 20px));
		max-height: calc(100dvh - 20px);
		overflow-y: auto;
		border: 1px solid rgb(4 0 55 / 0.08);
		border-radius: 14px;
		background: #ffffff;
		color: var(--p-ink);
		box-shadow: 0 32px 68px -20px rgb(4 0 55 / 0.35);
		opacity: 0;
		translate: 0 12px;
		transition:
			opacity 250ms,
			translate 350ms cubic-bezier(0.16, 1, 0.3, 1);
	}

	.consent.is-open {
		opacity: 1;
		translate: 0 0;
	}

	.consent[hidden] {
		display: none;
	}

	.consent__head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.9rem 1.25rem;
		border-bottom: 1px solid rgb(4 0 55 / 0.08);
	}

	.consent__head img {
		width: auto;
		height: 24px;
	}

	.consent__close {
		display: grid;
		place-items: center;
		width: 32px;
		height: 32px;
		padding: 0;
		border: 0;
		border-radius: 999px;
		background: none;
		color: var(--p-ink);
		cursor: pointer;
	}

	.consent__close[hidden] {
		display: none;
	}

	.consent__close svg {
		width: 20px;
		height: 20px;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
	}

	.consent__body {
		padding: 1.1rem 1.25rem 1rem;
	}

	.consent__body h2 {
		margin: 0 0 0.4rem;
		font-size: 1rem;
		font-weight: 700;
		letter-spacing: 0;
		line-height: 1.35;
	}

	.consent__body p {
		margin: 0;
		color: color-mix(in oklab, var(--p-ink) 85%, #ffffff);
		font-size: 0.9rem;
		line-height: 1.6;
	}

	.consent__body a {
		color: var(--p-ink);
		font-weight: 600;
		text-decoration: underline;
		text-decoration-color: var(--p-accent);
		text-underline-offset: 0.2em;
	}

	.consent__choice[hidden],
	.consent__body [hidden] {
		display: none;
	}

	.consent__choices {
		display: grid;
		grid-auto-columns: minmax(0, 1fr);
		grid-auto-flow: column;
		margin: 0;
		padding: 0;
		border: 0;
		border-top: 1px solid rgb(4 0 55 / 0.08);
	}

	.consent__choices legend {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
	}

	.consent__choice {
		display: grid;
		justify-items: center;
		gap: 0.6rem;
		padding: 0.9rem 0.5rem 1rem;
		font-size: 0.9rem;
		font-weight: 700;
		cursor: pointer;
	}

	.consent__choice + .consent__choice {
		border-left: 1px solid rgb(4 0 55 / 0.08);
	}

	.consent__choice input {
		position: relative;
		width: 46px;
		height: 26px;
		margin: 0;
		border-radius: 999px;
		background: var(--p-ink);
		cursor: pointer;
		appearance: none;
		transition: background-color 200ms;
	}

	.consent__choice input::after {
		content: "";
		position: absolute;
		top: 3px;
		left: 3px;
		width: 20px;
		height: 20px;
		border-radius: 50%;
		background: #ffffff;
		transition: translate 200ms cubic-bezier(0.16, 1, 0.3, 1);
	}

	.consent__choice input:checked {
		background: var(--p-accent);
	}

	.consent__choice input:checked::after {
		translate: 20px 0;
	}

	.consent__choice input:disabled {
		cursor: default;
		opacity: 0.55;
	}

	.consent__choice input:focus-visible {
		outline: 2px solid var(--p-ink);
		outline-offset: 2px;
	}

	.consent__actions {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.6rem;
		padding: 0.9rem 1.25rem 1.1rem;
		border-top: 1px solid rgb(4 0 55 / 0.08);
	}

	.consent__actions button {
		min-height: 44px;
		padding: 0 0.5rem;
		border: 2px solid var(--p-accent);
		border-radius: 8px;
		background: #ffffff;
		color: var(--p-ink);
		font: 600 0.9rem/1.2 var(--font-text);
		cursor: pointer;
		transition:
			background-color 150ms,
			color 150ms;
	}

	.consent__actions button:hover {
		background: rgb(237 76 76 / 0.08);
	}

	.consent__actions .consent__primary {
		background: var(--p-accent);
		color: #ffffff;
	}

	.consent__actions .consent__primary:hover {
		background: #d93636;
		border-color: #d93636;
	}

	@media (max-width: 1023px) {
		.consent {
			right: 10px;
			bottom: calc(84px + env(safe-area-inset-bottom));
			max-height: calc(100dvh - 104px - env(safe-area-inset-bottom));
		}
	}

	@media (max-width: 420px) {
		.consent__actions {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.consent__primary {
			grid-column: 1 / -1;
			order: -1;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.consent,
		.consent__choice input,
		.consent__choice input::after {
			transition: none;
		}
	}
</style>
