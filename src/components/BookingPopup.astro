---
import { BOOKING_PATH, CAL_CONFIG, CAL_LINK, CAL_ORIGIN } from "../utils/booking";
---

<script is:inline define:vars={{ bookingPath: BOOKING_PATH, calLink: CAL_LINK, calOrigin: CAL_ORIGIN, calConfig: CAL_CONFIG }}>
	const namespace = "befaring_popup";

	const loadCal = () => {
		if (window.Cal?.ns?.[namespace]) return window.Cal.ns[namespace];
		(function (C, A, L) {
			const push = (target, args) => target.q.push(args);
			C.Cal =
				C.Cal ||
				function () {
					const cal = C.Cal;
					const args = arguments;
					if (!cal.loaded) {
						cal.ns = {};
						cal.q = cal.q || [];
						C.document.head.appendChild(C.document.createElement("script")).src = A;
						cal.loaded = true;
					}
					if (args[0] === L) {
						const api = function () {
							push(api, arguments);
						};
						const ns = args[1];
						api.q = api.q || [];
						if (typeof ns === "string") {
							cal.ns[ns] = cal.ns[ns] || api;
							push(cal.ns[ns], args);
							push(cal, ["initNamespace", ns]);
						} else push(cal, args);
						return;
					}
					push(cal, args);
				};
		})(window, `${calOrigin}/embed/embed.js`, "init");
		window.Cal("init", namespace, { origin: calOrigin });
		window.Cal.ns[namespace]("ui", { theme: "light", hideEventTypeDetails: false, layout: "month_view" });
		return window.Cal.ns[namespace];
	};

	document.addEventListener("click", (event) => {
		if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
		const link = event.target instanceof Element ? event.target.closest("a[href]") : null;
		if (!link || link.target === "_blank") return;
		const url = new URL(link.href, location.href);
		if (url.origin !== location.origin || url.pathname.replace(/\/?$/, "/") !== bookingPath) return;
		if (location.pathname === bookingPath) return;
		event.preventDefault();
		loadCal()("modal", { calLink, config: calConfig });
	});
</script>
