---
interface Props {
	social: Partial<Record<string, string>> | undefined;
	class?: string;
}

const { social, class: className } = Astro.props;
const networks = [
	{ key: "facebook", label: "Facebook" },
	{ key: "instagram", label: "Instagram" },
	{ key: "linkedin", label: "LinkedIn" },
	{ key: "youtube", label: "YouTube" },
] as const;
const links = networks.flatMap((network) => {
	const url = social?.[network.key]?.trim();
	return url && /^https:\/\//.test(url) ? [{ ...network, url }] : [];
});
---

{
	links.length > 0 && (
		<ul class={className}>
			{links.map((link) => (
				<li>
					<a href={link.url} target="_blank" rel="noopener" aria-label={link.label}>
						{link.key === "facebook" && (
							<svg viewBox="0 0 24 24" aria-hidden="true">
								<path d="M13.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.5-1.5h1.6V4.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.8 1.4-3.8 3.9v2.3H7.9v3h2.6V21z" fill="currentColor" />
							</svg>
						)}
						{link.key === "instagram" && (
							<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8">
								<rect x="3.5" y="3.5" width="17" height="17" rx="5" />
								<circle cx="12" cy="12" r="4" />
								<circle cx="17.3" cy="6.7" r="0.6" fill="currentColor" stroke="none" />
							</svg>
						)}
						{link.key === "linkedin" && (
							<svg viewBox="0 0 24 24" aria-hidden="true">
								<path d="M6.9 8.7H3.6V20h3.3zM5.2 3.5a1.9 1.9 0 1 0 0 3.8 1.9 1.9 0 0 0 0-3.8M20.4 13.6c0-3.1-1.7-5.2-4.4-5.2-1.5 0-2.5.8-3 1.6V8.7H9.8V20h3.3v-5.8c0-1.6.6-2.8 2.1-2.8s2 1.2 2 2.8V20h3.2z" fill="currentColor" />
							</svg>
						)}
						{link.key === "youtube" && (
							<svg viewBox="0 0 24 24" aria-hidden="true">
								<path d="M21.6 7.2a2.7 2.7 0 0 0-1.9-1.9C18 4.8 12 4.8 12 4.8s-6 0-7.7.5a2.7 2.7 0 0 0-1.9 1.9C1.9 8.9 1.9 12 1.9 12s0 3.1.5 4.8a2.7 2.7 0 0 0 1.9 1.9c1.7.5 7.7.5 7.7.5s6 0 7.7-.5a2.7 2.7 0 0 0 1.9-1.9c.5-1.7.5-4.8.5-4.8s0-3.1-.5-4.8M10 15.1V8.9l5.2 3.1z" fill="currentColor" />
							</svg>
						)}
					</a>
				</li>
			))}
		</ul>
	)
}
