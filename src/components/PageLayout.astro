---
import { getEmDashEntry } from "emdash";
import { Blocks } from "emdash/ui";
import Booking from "./blocks/Booking.astro";
import Campaign from "./blocks/Campaign.astro";
import Cards from "./blocks/Cards.astro";
import Contact from "./blocks/Contact.astro";
import ContactForm from "./blocks/ContactForm.astro";
import Faq from "./blocks/Faq.astro";
import Features from "./blocks/Features.astro";
import Hero from "./blocks/Hero.astro";
import Logos from "./blocks/Logos.astro";
import MapBlock from "./blocks/Map.astro";
import PageHero from "./blocks/PageHero.astro";
import ProjectGallery from "./blocks/ProjectGallery.astro";
import Reviews from "./blocks/Reviews.astro";
import Section from "./blocks/Section.astro";
import Services from "./blocks/Services.astro";
import ServicesTabs from "./blocks/ServicesTabs.astro";
import Statement from "./blocks/Statement.astro";
import Steps from "./blocks/Steps.astro";

interface Props {
	value: unknown[] | undefined;
}

const { value } = Astro.props;
type LayoutBlock = { _type: string; _key?: string; background?: string; section?: string; [field: string]: unknown };
const layout = (value ?? []) as LayoutBlock[];
const sharedSlugs = [...new Set(layout.filter((block) => block._type === "shared_section" && block.section).map((block) => block.section!))];
const shared = new Map(
	await Promise.all(
		sharedSlugs.map(async (slug) => {
			const { entry, cacheHint } = await getEmDashEntry("shared_sections", slug);
			if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
			const target = entry ? JSON.stringify({ collection: "shared_sections", id: entry.data.id }) : undefined;
			const sections = ((entry?.data.layout ?? []) as LayoutBlock[]).filter((block) => block._type !== "shared_section");
			return [slug, sections.map((block) => ({ ...block, _entry: target }))] as const;
		}),
	),
);
const expanded = layout.flatMap((block) =>
	block._type === "shared_section"
		? (shared.get(block.section ?? "") ?? []).map((inner) => ({ ...inner, ...(block.background ? { background: block.background } : {}) }))
		: [block],
);
type TextNode = { style?: string; [field: string]: unknown };
const columns = ["column_1", "column_2", "column_3", "column_4"];
const demoteTitles = (layoutBlocks: LayoutBlock[]) =>
	layoutBlocks.map((block) => {
		if (block._type !== "section") return block;
		const demoted = { ...block };
		for (const column of columns) {
			const nodes = block[column] as TextNode[] | undefined;
			if (nodes) demoted[column] = nodes.map((node) => (node.style === "h1" ? { ...node, style: "h2" } : node));
		}
		return demoted;
	});
const promoteTitle = (layoutBlocks: LayoutBlock[]) => {
	if (layoutBlocks.some((block) => block._type === "hero" || block._type === "page_hero")) return demoteTitles(layoutBlocks);
	const at = layoutBlocks.findIndex((block) => block._type === "section");
	if (at < 0) return layoutBlocks;
	const section = layoutBlocks[at];
	for (const column of columns) {
		const nodes = (section[column] ?? []) as TextNode[];
		const heading = nodes.findIndex((node) => node.style === "h2" || node.style === "h3");
		if (heading < 0) continue;
		const promoted = { ...section, [column]: nodes.map((node, index) => (index === heading ? { ...node, style: "h1" } : node)) };
		return layoutBlocks.map((block, index) => (index === at ? promoted : block));
	}
	return layoutBlocks;
};
const blocks = promoteTitle(expanded).map((block) => ({ ...block })).reduce<LayoutBlock[]>((merged, block) => {
	const last = merged.at(-1);
	if (block._type === "campaign" && last?._type === "hero" && !last.campaign) {
		last.campaign = block;
	} else if (block._type === "services" && last?._type === "services_tabs") {
		(last.groups as LayoutBlock[]).push(block);
	} else if (block._type === "services" && last?._type === "services") {
		merged[merged.length - 1] = { _type: "services_tabs", _key: last._key, background: last.background, groups: [last, block] };
	} else {
		merged.push(block);
	}
	return merged;
}, []);
const components = {
	hero: Hero,
	campaign: Campaign,
	page_hero: PageHero,
	map: MapBlock,
	project_gallery: ProjectGallery,
	logos: Logos,
	services: Services,
	services_tabs: ServicesTabs,
	features: Features,
	statement: Statement,
	steps: Steps,
	contact: Contact,
	section: Section,
	cards: Cards,
	faq: Faq,
	contact_form: ContactForm,
	booking: Booking,
	reviews: Reviews,
};
---

<Blocks value={blocks as never} components={components as never} />
