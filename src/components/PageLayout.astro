---
import { Blocks } from "emdash/ui";
import Booking from "./blocks/Booking.astro";
import Campaign from "./blocks/Campaign.astro";
import Cards from "./blocks/Cards.astro";
import Contact from "./blocks/Contact.astro";
import ContactForm from "./blocks/ContactForm.astro";
import Faq from "./blocks/Faq.astro";
import Features from "./blocks/Features.astro";
import Hero from "./blocks/Hero.astro";
import Logos from "./blocks/Logos.astro";
import PageHero from "./blocks/PageHero.astro";
import Reviews from "./blocks/Reviews.astro";
import Section from "./blocks/Section.astro";
import Services from "./blocks/Services.astro";
import ServicesTabs from "./blocks/ServicesTabs.astro";
import Statement from "./blocks/Statement.astro";
import Steps from "./blocks/Steps.astro";

interface Props {
	value: unknown[] | undefined;
}

const { value } = Astro.props;
type LayoutBlock = { _type: string; _key?: string; background?: string; [field: string]: unknown };
const blocks = ((value ?? []) as LayoutBlock[]).map((block) => ({ ...block })).reduce<LayoutBlock[]>((merged, block) => {
	const last = merged.at(-1);
	if (block._type === "campaign" && last?._type === "hero" && !last.campaign) {
		last.campaign = block;
	} else if (block._type === "services" && last?._type === "services_tabs") {
		(last.groups as LayoutBlock[]).push(block);
	} else if (block._type === "services" && last?._type === "services") {
		merged[merged.length - 1] = { _type: "services_tabs", _key: last._key, background: last.background, groups: [last, block] };
	} else {
		merged.push(block);
	}
	return merged;
}, []);
const components = {
	hero: Hero,
	campaign: Campaign,
	page_hero: PageHero,
	logos: Logos,
	services: Services,
	services_tabs: ServicesTabs,
	features: Features,
	statement: Statement,
	steps: Steps,
	contact: Contact,
	section: Section,
	cards: Cards,
	faq: Faq,
	contact_form: ContactForm,
	booking: Booking,
	reviews: Reviews,
};
---

<Blocks value={blocks as never} components={components as never} />
