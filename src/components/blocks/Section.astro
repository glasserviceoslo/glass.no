---
import { Image } from "emdash/ui";
import RichText from "../RichText.astro";
import { slugOf, textOf } from "../../utils/slug";
import type { Surface } from "./surface";

interface Props {
	value: Surface & {
		layout?: string;
		align?: string;
		column_1?: unknown[];
		column_2?: unknown[];
		column_3?: unknown[];
		column_4?: unknown[];
		anchor_id?: string;
	};
}

const { value } = Astro.props;
const columns = [value.column_1, value.column_2, value.column_3, value.column_4].filter((column) => column?.length);
const layout = value.layout ?? "1";
const background = value.background ?? "white";
const contents =
	layout === "1"
		? ((value.column_1 ?? []) as { style?: string; children?: { text?: string }[] }[])
				.filter((node) => node.style === "h1" || node.style === "h2")
				.map((node) => ({ id: slugOf(textOf(node)), text: textOf(node) }))
		: [];
const guide = contents.length >= 4;
---

{
	columns.length > 0 && (
		<section id={value.anchor_id || undefined} class:list={["block", "section", `surface--${background}`]}>
			{background === "image" && value.background_image && (
				<>
					<Image image={value.background_image} class="section__backdrop" sizes="100vw" />
					<div class="section__shade" />
				</>
			)}
			{guide ? (
				<div class="container guide">
					<nav class="guide__nav" aria-label="Innhold">
						<details open>
							<summary>Innhold</summary>
							<ol>
								{contents.map((item) => (
									<li>
										<a href={`#${item.id}`}>{item.text}</a>
									</li>
								))}
							</ol>
						</details>
					</nav>
					<RichText value={columns[0]} class="section__column guide__text" />
				</div>
			) : (
				<div
					class:list={["container", "section__grid", `section__grid--${layout}`, { "section__grid--center": value.align === "center" }]}
					style={`--columns: ${columns.length}`}
				>
					{columns.map((column) => (
						<RichText value={column} class="section__column" />
					))}
				</div>
			)}
		</section>
	)
}

<style>
	.block > :global(.section__backdrop) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.section__shade {
		position: absolute;
		inset: 0;
		background: color-mix(in oklab, var(--p-inv-bg) 58%, transparent);
	}

	.section__grid {
		position: relative;
		display: grid;
		gap: clamp(1.5rem, 4vw, 3.5rem);
		align-items: center;
		grid-template-columns: repeat(var(--columns), minmax(0, 1fr));
	}

	.section__grid--2-1 {
		grid-template-columns: 2fr 1fr;
	}

	.section__grid--1-2 {
		grid-template-columns: 1fr 2fr;
	}

	.section__grid--center {
		text-align: center;
	}

	.section__grid--center :global(img) {
		margin-inline: auto;
	}

	.section__grid--1 :global(.prose) {
		width: 100%;
		max-width: 60ch;
		margin-inline: auto;
	}

	.section__grid--1 :global(.prose > *) {
		max-width: none;
	}

	.section__grid--1 :global(.prose:has(> .gallery:only-child)) {
		max-width: none;
	}

	.section__grid :global(.section__column img) {
		width: 100%;
		object-fit: cover;
	}

	.guide {
		display: grid;
		grid-template-columns: minmax(12rem, 16rem) minmax(0, 60ch);
		gap: clamp(2rem, 5vw, 5rem);
		justify-content: center;
		align-items: start;
	}

	.guide__nav {
		position: sticky;
		top: calc(var(--nav-h, 72px) + 1.5rem);
		max-height: calc(100svh - var(--nav-h, 72px) - 3rem);
		overflow: auto;
		font-size: 0.9rem;
	}

	.guide__nav summary {
		margin-bottom: 0.75rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		font-size: 0.8rem;
		cursor: pointer;
		list-style: none;
	}

	.guide__nav summary::-webkit-details-marker {
		display: none;
	}

	.guide__nav ol {
		display: grid;
		gap: 0.15rem;
		margin: 0;
		padding: 0;
		list-style: none;
		border-left: 1px solid var(--line);
	}

	.guide__nav a {
		display: block;
		padding: 0.4rem 0 0.4rem 1rem;
		margin-left: -1px;
		border-left: 1px solid transparent;
		color: var(--flow-muted);
		line-height: 1.35;
		text-decoration: none;
		transition: color 160ms ease, border-color 160ms ease;
	}

	.guide__nav a:hover,
	.guide__nav a:focus-visible {
		border-left-color: var(--p-accent);
		color: var(--p-ink);
	}

	.guide :global(.guide__text h2) {
		scroll-margin-top: calc(var(--nav-h, 72px) + 1.5rem);
	}

	.guide :global(.guide__text > *) {
		max-width: none;
	}

	.guide :global(.guide__text :is(p, li)) {
		font-size: 1.0625rem;
		line-height: 1.7;
		text-wrap: pretty;
	}

	.guide :global(.guide__text h2) {
		margin: 2.6em 0 0.7em;
		font-size: clamp(1.75rem, 2.5vw, 2.25rem);
		line-height: 1.15;
		letter-spacing: -0.02em;
		text-wrap: balance;
	}

	.guide :global(.guide__text h2:first-child) {
		margin-top: 0;
	}

	.guide :global(.guide__text h3) {
		margin: 2em 0 0.5em;
		font-family: var(--font-text), sans-serif;
		font-size: 1.25rem;
		font-weight: 600;
		line-height: 1.3;
		letter-spacing: -0.01em;
		text-wrap: balance;
	}

	.guide :global(.guide__text h2 + h3) {
		margin-top: 0.4em;
	}

	.guide :global(.guide__text :is(td, th)) {
		font-size: 0.9375rem;
	}

	@media (max-width: 960px) {
		.guide {
			grid-template-columns: minmax(0, 1fr);
		}

		.guide__nav {
			position: static;
			max-height: none;
			padding: 1rem 1.25rem;
			border: 1px solid var(--line);
			border-radius: var(--radius-small, 12px);
		}

		.guide__nav summary {
			margin-bottom: 0;
		}

		.guide__nav details[open] summary {
			margin-bottom: 0.75rem;
		}
	}

	@media (max-width: 860px) {
		.section__grid,
		.section__grid--2-1,
		.section__grid--1-2 {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
