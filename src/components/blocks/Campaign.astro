---
import { Image } from "emdash/ui";
import Arrow from "../Arrow.astro";
import { safeHref } from "../../utils/href";
import type { ImageValue } from "./surface";

interface Props {
	value: { _key?: string; _entry?: string;
		label?: string;
		figure?: string;
		heading: string;
		text?: string;
		note?: string;
		cta_label?: string;
		cta_url?: string;
		image?: ImageValue;
	};
}

const { value } = Astro.props;
const ctaUrl = safeHref(value.cta_url);
---

<section data-block={value._key} data-entry={value._entry} class="section campaign" id="kampanje" aria-labelledby="kampanje-h">
	<div class="wrap">
		<div class:list={["campaign__grid", { "campaign__grid--text": !value.image }]}>
			<div class="campaign__text">
				{value.label && <p class="campaign__label" data-field="label">{value.label}</p>}
				{value.figure && <p class="campaign__figure" aria-hidden="true">{value.figure}</p>}
				<h2 id="kampanje-h" data-field="heading">{value.heading}</h2>
				{value.text && <p class="campaign__body" data-field="text">{value.text}</p>}
				{
					value.note && (
						<p class="campaign__note">
							<svg viewBox="0 0 24 24" aria-hidden="true">
								<circle cx="12" cy="12" r="8.5" />
								<path d="M12 7.5V12l3 2" />
							</svg>
							{value.note}
						</p>
					)
				}
				{
					value.cta_label && ctaUrl && (
						<a class="btn btn--primary campaign__cta" href={ctaUrl}>
							{value.cta_label}
							<Arrow />
						</a>
					)
				}
			</div>
			{
				value.image && (
					<a class="campaign__poster" href={ctaUrl ?? "/kampanje/"} tabindex="-1" aria-hidden="true">
						<span class="campaign__frame">
							<Image image={value.image} alt="" sizes="(max-width: 900px) 100vw, 560px" />
						</span>
					</a>
				)
			}
		</div>
	</div>
</section>

<style>
	.campaign {
		position: relative;
		overflow: hidden;
		padding-block: clamp(3.5rem, 7vw, 6rem);
		background: var(--p-ink);
		color: #f8f9fa;
		isolation: isolate;
	}

	.campaign::before,
	.campaign::after {
		content: "";
		position: absolute;
		z-index: -1;
		width: 46%;
		height: 0.9rem;
		background: var(--p-accent);
		transform: skewY(-12deg);
	}

	.campaign::before {
		top: 14%;
		right: -6%;
	}

	.campaign::after {
		bottom: 12%;
		left: -10%;
		opacity: 0.55;
	}

	.campaign__grid {
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
		gap: clamp(2.5rem, 6vw, 6rem);
		align-items: center;
	}

	.campaign__grid--text {
		grid-template-columns: minmax(0, 46rem);
	}

	.campaign__text {
		display: grid;
		justify-items: start;
		gap: 1.1rem;
	}

	.campaign__label {
		margin: 0;
		padding: 0.4rem 0.9rem;
		border-radius: 999px;
		background: var(--p-action);
		color: #ffffff;
		font-size: var(--type-caption);
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.campaign__figure {
		margin: 0.25rem 0 -0.5rem;
		color: var(--p-accent);
		font-size: clamp(5rem, 13vw, 10.5rem);
		font-weight: 700;
		line-height: 0.85;
		letter-spacing: -0.05em;
		font-variant-numeric: tabular-nums;
	}

	.campaign h2 {
		max-width: 16ch;
		margin: 0;
		color: #ffffff;
		font-size: var(--type-h2);
		font-weight: 500;
		line-height: 1.04;
		letter-spacing: -0.03em;
		text-wrap: balance;
	}

	.campaign__body {
		max-width: 44ch;
		margin: 0;
		color: color-mix(in oklab, #f8f9fa 80%, var(--p-ink));
		font-size: var(--type-lead);
		line-height: 1.6;
	}

	.campaign__note {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		margin: 0.25rem 0 0;
		color: #ffffff;
		font-size: var(--type-reading);
		font-weight: 600;
	}

	.campaign__note svg {
		width: 1.35rem;
		height: 1.35rem;
		fill: none;
		stroke: var(--p-accent);
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.campaign__cta {
		min-height: 52px;
		margin-top: 0.75rem;
		padding-inline: 1.6rem;
		font-size: var(--type-reading);
		font-weight: 600;
	}

	.campaign__poster {
		position: relative;
		display: block;
		justify-self: end;
		width: min(100%, 34rem);
	}

	.campaign__poster::before {
		content: "";
		position: absolute;
		inset: 1.25rem -1.25rem -1.25rem 1.25rem;
		border-radius: 24px;
		background: var(--p-accent);
	}

	.campaign__frame {
		position: relative;
		display: block;
		overflow: hidden;
		border-radius: 24px;
		aspect-ratio: 1 / 1;
		box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.6);
	}

	.campaign__frame :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: scale 700ms cubic-bezier(0.2, 0.8, 0.2, 1);
	}

	.campaign__poster:hover .campaign__frame :global(img) {
		scale: 1.03;
	}

	@media (max-width: 900px) {
		.campaign__grid {
			grid-template-columns: minmax(0, 1fr);
		}

		.campaign__poster {
			justify-self: start;
			width: calc(100% - 1.25rem);
		}

		.campaign::before {
			display: none;
		}

		.campaign::after {
			width: 70%;
			bottom: 4%;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.campaign__frame :global(img) {
			transition: none;
		}
	}
</style>
