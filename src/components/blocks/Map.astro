---
interface Props {
	value: { _key?: string; _entry?: string; address: string; hours?: string; latitude: number; longitude: number };
}

const { value } = Astro.props;
const { latitude: lat, longitude: lon } = value;
const embed = `https://maps.google.com/maps?${new URLSearchParams({ q: value.address, ll: `${lat},${lon}`, z: "16", hl: "no", output: "embed" })}`;
const directions = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(value.address)}`;
---

<section data-block={value._key} data-entry={value._entry} class="map" aria-label={value.address}>
	<div class="wrap">
		<div class="map__frame">
			<iframe data-map-src={embed} title={value.address} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen hidden></iframe>
			<button class="map__consent" type="button">
				<svg class="map__pin" viewBox="0 0 32 42" aria-hidden="true"><path d="M16 41s14-13.4 14-25A14 14 0 0 0 2 16c0 11.6 14 25 14 25Z" /><circle cx="16" cy="16" r="5.5" /></svg>
				<span>Vis kart</span>
			</button>
			<div class="map__card">
				<a href={directions} target="_blank" rel="noopener">
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z" /><circle cx="12" cy="10" r="2.4" /></svg>
					<span data-field="address">{value.address}</span>
				</a>
				{value.hours && <p data-field="hours">{value.hours}</p>}
			</div>
		</div>
	</div>
</section>

<style>
	.map {
		padding-block: 0 clamp(3rem, 6vw, 5rem);
		background: var(--p-bg);
	}

	.map__frame {
		position: relative;
		overflow: hidden;
		height: clamp(320px, 42vw, 520px);
		border-radius: clamp(22px, 3vw, 32px);
		background: var(--p-surface);
		box-shadow: 0 1px 2px rgb(4 0 55 / 0.06);
	}

	.map__frame iframe[hidden],
	.map__consent[hidden] {
		display: none;
	}

	.map__consent {
		position: absolute;
		inset: 0;
		display: grid;
		place-content: center;
		justify-items: center;
		gap: 1rem;
		width: 100%;
		padding: 0 0 clamp(5rem, 9vw, 6rem);
		border: 0;
		background:
			linear-gradient(rgb(4 0 55 / 0.045) 1px, transparent 1px) 0 0 / 48px 48px,
			linear-gradient(90deg, rgb(4 0 55 / 0.045) 1px, transparent 1px) 0 0 / 48px 48px,
			var(--p-surface);
		cursor: pointer;
	}

	.map__pin {
		width: 40px;
		height: 52px;
		filter: drop-shadow(0 8px 10px rgb(4 0 55 / 0.3));
	}

	.map__pin path {
		fill: var(--p-accent);
	}

	.map__pin circle {
		fill: #ffffff;
	}

	.map__consent span {
		display: inline-flex;
		align-items: center;
		height: 44px;
		padding: 0 1.25rem;
		border-radius: 999px;
		background: #ffffff;
		color: var(--p-ink);
		font: 600 0.95rem/1 var(--font-text);
		box-shadow: 0 10px 24px -12px rgb(4 0 55 / 0.35);
		transition:
			background-color 150ms,
			color 150ms;
	}

	.map__consent:hover span,
	.map__consent:focus-visible span {
		background: var(--p-ink);
		color: #ffffff;
	}

	.map__frame iframe {
		display: block;
		width: 100%;
		height: 100%;
		border: 0;
	}

	.map__card {
		position: absolute;
		bottom: clamp(12px, 2vw, 24px);
		left: clamp(12px, 2vw, 24px);
		display: grid;
		gap: 0.3rem;
		max-width: calc(100% - 24px);
		padding: 1rem 1.25rem;
		border: 1px solid rgb(255 255 255 / 0.8);
		border-radius: 20px;
		background: rgb(255 255 255 / 0.82);
		color: var(--p-ink);
		box-shadow: 0 18px 40px -20px rgb(4 0 55 / 0.4);
		-webkit-backdrop-filter: blur(16px) saturate(180%);
		backdrop-filter: blur(16px) saturate(180%);
	}

	.map__card a {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		color: var(--p-ink);
		font-size: 1.1rem;
		font-weight: 600;
		text-decoration: none;
	}

	.map__card a:hover {
		text-decoration: underline;
		text-decoration-color: var(--p-accent);
		text-underline-offset: 0.2em;
	}

	.map__card svg {
		flex: none;
		width: 20px;
		height: 20px;
		fill: none;
		stroke: var(--p-accent);
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.map__card p {
		margin: 0;
		padding-left: calc(20px + 0.45rem);
		color: var(--p-muted);
		font-size: 0.95rem;
	}
</style>

<script>
	import * as CookieConsent from "vanilla-cookieconsent";

	const sync = () => {
		const allowed = CookieConsent.acceptedCategory("kart");
		document.querySelectorAll<HTMLElement>(".map__frame").forEach((frame) => {
			const map = frame.querySelector("iframe")!;
			if (allowed && !map.src) map.src = map.dataset.mapSrc!;
			map.hidden = !allowed;
			frame.querySelector<HTMLElement>(".map__consent")!.hidden = allowed;
		});
	};

	document.querySelectorAll(".map__consent").forEach((button) =>
		button.addEventListener("click", () => CookieConsent.acceptCategory([...CookieConsent.getUserPreferences().acceptedCategories, "kart"])),
	);
	window.addEventListener("cc:onConsent", sync);
	window.addEventListener("cc:onChange", sync);
	sync();
</script>
