---
import { Image } from "emdash/ui";
import type { ImageValue } from "./surface";

type Step = { title: string; text?: string; image?: ImageValue };

interface Props {
	value: { heading: string; items?: Step[] };
}

const { value } = Astro.props;
const items = (value.items ?? []).slice(0, 4);
const span = items.length === 4 ? "span-3" : items.length === 3 ? "span-4" : "span-6";
---

<section class="section" id="slik-jobber-vi" aria-labelledby="slik-jobber-vi-h">
	<div class="wrap">
		<div class="section-head">
			<h2 id="slik-jobber-vi-h">{value.heading}</h2>
		</div>
		<ol class="grid steps">
			{
				items.map((item) => (
					<li class:list={["card card--open", span]}>
						{item.image && (
							<div class="panel steps__photo">
								<Image image={item.image} alt={item.image.alt ?? ""} class="frame__img" sizes="(max-width: 639px) 700px, 420px" />
							</div>
						)}
						<h3>{item.title}</h3>
						{item.text && <p>{item.text}</p>}
					</li>
				))
			}
		</ol>
	</div>
</section>

<style>
	.steps {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.steps__photo {
		height: auto;
		aspect-ratio: 4 / 3;
		overflow: hidden;
	}

	.steps__photo :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	@media (max-width: 1023px) {
		.steps > li {
			grid-column: span 6;
		}
	}

	@media (max-width: 639px) {
		.steps > li {
			grid-column: 1 / -1;
		}
	}
</style>
