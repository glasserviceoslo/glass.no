---
import { Image } from "emdash/ui";
import { safeHref } from "../../utils/href";
import ContactFormFields from "../ContactFormFields.astro";
import type { ImageValue } from "./surface";

interface Props {
	value: { _key?: string; _entry?: string;
		background?: "white" | "light" | "tint" | "dark" | "brand";
		heading: string;
		intro?: string;
		address?: string;
		hours?: string;
		phone?: string;
		primary_label?: string;
		primary_url?: string;
		image?: ImageValue;
		show_form?: boolean;
	};
}

const { value } = Astro.props;
const addressLines = (value.address ?? "").split("\n").map((line) => line.trim()).filter(Boolean);
const hours = (value.hours ?? "")
	.split("\n")
	.map((line) => line.split("|").map((part) => part.trim()))
	.filter(([days, time]) => days && time);
const mapUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(addressLines.join(", "))}`;
const primaryUrl = safeHref(value.primary_url);
const tel = value.phone?.replace(/[^+\d]/g, "");
---

<section data-block={value._key} data-entry={value._entry} class:list={["section", "contact", value.background && `surface--${value.background}`]} id="kontakt" aria-labelledby="kontakt-h">
	<div class="wrap">
		<div class="contact__grid">
			<div class="contact__info">
				<div>
					<h2 id="kontakt-h" data-field="heading">{value.heading}</h2>
					{value.intro && <p class="contact__intro" data-field="intro">{value.intro}</p>}
				</div>
				<ul class="contact__list">
					{
						addressLines.length > 0 && (
							<li>
								<a class="contact__place" href={mapUrl} target="_blank" rel="noopener">
									<span class="contact__icon" aria-hidden="true">
										<svg viewBox="0 0 24 24">
											<path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z" />
											<circle cx="12" cy="10" r="2.4" />
										</svg>
									</span>
									<address class="contact__text">{addressLines.join(", ")}</address>
								</a>
							</li>
						)
					}
					{
						hours.map(([days, time]) => (
							<li>
								<span class="contact__icon" aria-hidden="true">
									<svg viewBox="0 0 24 24">
										<circle cx="12" cy="12" r="8.5" />
										<path d="M12 7.5V12l3 2" />
									</svg>
								</span>
								<span class="contact__text">
									{days} {time}
								</span>
							</li>
						))
					}
					{
						value.phone && tel && (
							<li>
								<span class="contact__icon" aria-hidden="true">
									<svg viewBox="0 0 24 24">
										<path d="M6.6 3.5h2.6l1.4 4-2 1.3a12 12 0 0 0 6.6 6.6l1.3-2 4 1.4v2.6a2 2 0 0 1-2.2 2A17 17 0 0 1 4.5 5.7a2 2 0 0 1 2.1-2.2Z" />
									</svg>
								</span>
								<a class="contact__text contact__tel" href={`tel:${tel}`}>
									{value.phone}
								</a>
							</li>
						)
					}
				</ul>
				{
					value.primary_label && primaryUrl && (
						<div class="btn-row">
							<a class="btn btn--secondary" href={primaryUrl}>
								{value.primary_label}
							</a>
						</div>
					)
				}
			</div>
			{
				value.show_form ? (
					<div class="contact__card">
						<ContactFormFields id="kontakt-skjema" />
					</div>
				) : (
					value.image && (
						<div class="contact__photo">
							<Image image={value.image} alt={value.image.alt ?? ""} sizes="(max-width: 900px) 100vw, 640px" />
						</div>
					)
				)
			}
		</div>
	</div>
</section>

<style>
	.contact {
		padding-block: clamp(3.5rem, 7vw, 6.5rem);
	}

	.contact__grid {
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
		gap: clamp(2.5rem, 6vw, 6rem);
		align-items: center;
	}

	.contact__info {
		display: grid;
		gap: 2rem;
	}

	.contact h2 {
		margin: 0;
		font-size: var(--type-h2);
		font-weight: 400;
		line-height: 1.06;
		letter-spacing: -0.03em;
		text-wrap: balance;
	}

	.contact__intro {
		margin: 1rem 0 0;
		color: var(--p-muted);
	}

	.contact__list {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.contact__list li {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding-block: 1rem;
		border-bottom: 1px solid color-mix(in oklab, var(--p-ink) 11%, transparent);
	}

	.contact__list li:first-child {
		border-top: 1px solid color-mix(in oklab, var(--p-ink) 11%, transparent);
	}

	.contact__icon {
		flex: none;
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 50%;
		background: var(--p-accent);
		color: #ffffff;
	}

	.contact__icon svg {
		width: 1.3rem;
		height: 1.3rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.8;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.contact__text {
		display: grid;
		gap: 0.1rem;
		color: inherit;
		font-size: var(--type-reading);
		font-weight: 500;
		text-decoration: none;
	}

	.contact__place {
		display: flex;
		align-items: center;
		gap: 1rem;
		color: inherit;
		text-decoration: none;
	}

	.contact__place address {
		font-style: normal;
	}

	.contact__place:hover .contact__icon {
		background: color-mix(in oklab, var(--p-accent) 86%, #000);
	}

	.contact__tel {
		padding-block: 0.6rem;
		margin-block: -0.6rem;
	}

	.contact__place:hover address,
	.contact__tel:hover {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.contact__card {
		padding: clamp(1.75rem, 4vw, 3rem);
		border-radius: 28px;
		background: var(--p-ink);
		color: #f8f9fa;
		box-shadow: 0 30px 60px -36px rgb(4 0 55 / 0.6);
	}

	.contact__card :global(.form) {
		gap: 1.1rem 1rem;
	}

	.contact__card :global(label) {
		color: #f8f9fa;
	}

	.contact__card :global(:is(input, textarea)) {
		border-color: transparent;
		background: #ffffff;
		color: var(--p-ink);
	}

	.contact__card :global(:is(.field__error, .form__status)) {
		color: #ffb4ad;
	}

	.contact__photo {
		overflow: hidden;
		border-radius: 24px;
		aspect-ratio: 4 / 3;
	}

	.contact__photo :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	@media (max-width: 900px) {
		.contact__grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
