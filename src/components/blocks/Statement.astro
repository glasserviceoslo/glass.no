---
import { Image } from "emdash/ui";
import type { ImageValue } from "./surface";

interface Props {
	value: { _key?: string; _entry?: string; background?: "white" | "light" | "tint" | "dark" | "brand"; label?: string; text: string; strong?: string; image?: ImageValue };
}

const { value } = Astro.props;
const at = value.strong ? value.text.indexOf(value.strong) : -1;
const parts = at >= 0 ? [value.text.slice(0, at), value.strong, value.text.slice(at + (value.strong?.length ?? 0))] : [value.text];
---

<section data-block={value._key} data-entry={value._entry} class:list={["section", "statement", value.background && `surface--${value.background}`]} id="om-oss" aria-label={value.label ?? "Om oss"}>
	<div class="wrap">
		<div class:list={["statement__grid", { "statement__grid--text": !value.image }]}>
			{
				value.image && (
					<div class="statement__photo">
						<Image image={value.image} alt={value.image.alt ?? ""} sizes="(max-width: 900px) 100vw, 760px" />
					</div>
				)
			}
			<div>
				{value.label && <p class="statement__label" data-field="label">{value.label}</p>}
				<p class="statement__text">
					{parts[0]}
					{parts.length > 1 && <strong>{parts[1]}</strong>}
					{parts[2]}
				</p>
			</div>
		</div>
	</div>
</section>

<style>
	.statement {
		padding-block: clamp(3.5rem, 7vw, 6.5rem);
	}

	.statement__grid {
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
		gap: clamp(2.5rem, 6vw, 6rem);
		align-items: center;
	}

	.statement__grid--text {
		grid-template-columns: minmax(0, 46rem);
	}

	.statement__photo {
		overflow: hidden;
		border-radius: 22px;
		aspect-ratio: 4 / 3;
		background: var(--p-surface);
	}

	.statement__photo :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.statement__label {
		margin: 0 0 0.6rem;
		color: var(--p-muted);
		font-size: var(--type-caption);
	}

	.statement__text {
		margin: 0;
		font-size: var(--type-quote);
		line-height: 1.6;
		text-wrap: pretty;
	}

	.statement__text strong {
		padding-bottom: 0.08em;
		background: linear-gradient(var(--p-accent), var(--p-accent)) left bottom / 100% 0.12em no-repeat;
		color: var(--p-ink);
		font-weight: 600;
	}

	@media (prefers-reduced-motion: no-preference) {
		@supports (animation-timeline: view()) {
			.statement__photo :global(img) {
				scale: 1.12;
				animation: statement-drift linear both;
				animation-timeline: view();
				animation-range: cover 0% cover 100%;
			}

			.statement__text strong {
				animation: statement-draw linear both;
				animation-timeline: view();
				animation-range: entry 70% cover 50%;
			}
		}
	}

	@keyframes statement-drift {
		from {
			translate: 0 -6%;
		}

		to {
			translate: 0 6%;
		}
	}

	@keyframes statement-draw {
		from {
			background-size: 0% 0.12em;
		}
	}

	@media (max-width: 900px) {
		.statement__grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
