---
import { Image } from "emdash/ui";
import type { ImageValue } from "./surface";

interface Props {
	value: { background?: "white" | "light" | "tint" | "dark" | "brand"; label?: string; text: string; strong?: string; image?: ImageValue };
}

const { value } = Astro.props;
const at = value.strong ? value.text.indexOf(value.strong) : -1;
const parts = at >= 0 ? [value.text.slice(0, at), value.strong, value.text.slice(at + (value.strong?.length ?? 0))] : [value.text];
---

<section class:list={["section", "statement", value.background && `surface--${value.background}`]} id="om-oss" aria-label={value.label ?? "Om oss"}>
	<div class="wrap">
		<div class:list={["statement__grid", { "statement__grid--text": !value.image }]}>
			{
				value.image && (
					<div class="statement__photo">
						<Image image={value.image} alt={value.image.alt ?? ""} sizes="(max-width: 900px) 100vw, 760px" />
					</div>
				)
			}
			<div>
				{value.label && <p class="statement__label">{value.label}</p>}
				<p class="statement__text">
					{parts[0]}
					{parts.length > 1 && <strong>{parts[1]}</strong>}
					{parts[2]}
				</p>
			</div>
		</div>
	</div>
</section>

<style>
	.statement {
		padding-block: clamp(3.5rem, 7vw, 6.5rem);
	}

	.statement__grid {
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
		gap: clamp(2.5rem, 6vw, 6rem);
		align-items: center;
	}

	.statement__grid--text {
		grid-template-columns: minmax(0, 46rem);
	}

	.statement__photo {
		overflow: hidden;
		border-radius: 22px;
		aspect-ratio: 4 / 3;
		background: var(--p-surface);
	}

	.statement__photo :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.statement__label {
		margin: 0 0 0.6rem;
		color: var(--p-muted);
		font-size: 0.875rem;
	}

	.statement__text {
		margin: 0;
		font-size: clamp(1.15rem, 1.6vw, 1.4rem);
		line-height: 1.6;
		text-wrap: pretty;
	}

	.statement__text strong {
		color: var(--p-ink);
		font-weight: 600;
	}

	@media (max-width: 900px) {
		.statement__grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
