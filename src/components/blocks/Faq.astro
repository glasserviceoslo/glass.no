---
import type { Surface } from "./surface";

interface Props {
	value: Surface & { label?: string; heading?: string; intro?: string; items?: { question: string; answer: string }[] };
}

const { value } = Astro.props;
const items = value.items ?? [];
const paragraphs = (text: string) => text.split(/\n\s*\n/).filter((paragraph) => paragraph.trim());
const headingId = `faq-${Math.abs([...(value.heading ?? "faq")].reduce((hash, char) => (hash * 31 + char.charCodeAt(0)) | 0, 7)).toString(36)}`;
const jsonLd = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	mainEntity: items.map((item) => ({
		"@type": "Question",
		name: item.question,
		acceptedAnswer: { "@type": "Answer", text: item.answer },
	})),
};
---

<section class:list={["section", "faq-section", value.background && `surface--${value.background}`]} style="--h: 1; --hm: 2" aria-labelledby={value.heading ? headingId : undefined}>
	<div class="wrap">
		<div class="grid grid--top">
			<div class="span-5 section-head">
				{value.label && <p class="t-label">{value.label}</p>}
				{value.heading && <h2 id={headingId}>{value.heading}</h2>}
				{value.intro && <p>{value.intro}</p>}
			</div>
			<div class="qa span-6 start-7">
				{
					items.map((item) => (
						<details class="qa__item">
							<summary class="qa__question">
								<h3>{item.question}</h3>
							</summary>
							{paragraphs(item.answer).map((paragraph) => (
								<p class="qa__answer">{paragraph}</p>
							))}
						</details>
					))
				}
			</div>
		</div>
	</div>
	<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</section>

<style>
	.faq-section:has(.qa__item[open]) {
		height: auto;
		min-height: calc(var(--h, 1) * 100svh);
	}

	.qa__item {
		border-bottom: 1px solid var(--line);
	}

	.qa__question {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--s-5);
		min-height: 44px;
		padding: var(--s-4) 0;
		cursor: pointer;
		list-style: none;
	}

	.qa__question::-webkit-details-marker {
		display: none;
	}

	.qa__question h3 {
		margin: 0;
		font: 500 var(--t-lead) / 1.4 var(--font-text);
		letter-spacing: 0;
	}

	.qa__question::after {
		flex: none;
		width: 10px;
		height: 10px;
		border-right: 2px solid currentColor;
		border-bottom: 2px solid currentColor;
		transform: translateY(-3px) rotate(45deg);
		transition: transform 0.2s ease;
		content: "";
	}

	.qa__item[open] .qa__question::after {
		transform: translateY(2px) rotate(-135deg);
	}

	.qa__answer {
		max-width: 64ch;
		margin: 0 0 var(--s-4);
		white-space: pre-line;
	}
</style>
