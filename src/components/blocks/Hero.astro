---
import { Image } from "emdash/ui";
import Arrow from "../Arrow.astro";
import { safeHref } from "../../utils/href";
import type { ImageValue } from "./surface";

interface Props {
	value: {
		kicker?: string;
		heading: string;
		lead?: string;
		primary_label?: string;
		primary_url?: string;
		secondary_label?: string;
		secondary_url?: string;
		image?: ImageValue;
		float_label?: string;
		float_title?: string;
	};
}

const { value } = Astro.props;
const primaryUrl = safeHref(value.primary_url);
const secondaryUrl = safeHref(value.secondary_url);
const facts = [value.kicker, value.float_label].filter(Boolean);
---

<section class="hero hero--film home-hero" data-enter aria-labelledby="hero-h">
	<div class="wrap">
		<div class="hero-text hero__in">
			<div class="hero__media hero__fill">
				{value.image && <Image image={value.image} alt={value.image.alt ?? ""} priority sizes="(max-width: 1440px) 92vw, 1280px" class="home-hero__img" />}
				<div class="hero__over">
					<div>
						<h1 id="hero-h" data-enter-whole>{value.heading}</h1>
						{value.lead && <p class="hero__lead">{value.lead}</p>}
						<div class="btn-row">
							{value.primary_label && primaryUrl && (
								<a class="btn btn--primary" href={primaryUrl}>
									{value.primary_label}
									<Arrow />
								</a>
							)}
							{value.secondary_label && secondaryUrl && (
								<a class="btn btn--secondary" href={secondaryUrl}>
									{value.secondary_label}
								</a>
							)}
						</div>
						{facts.length > 0 && (
							<p class="home-hero__facts">
								{facts.map((fact) => (
									<span>{fact}</span>
								))}
							</p>
						)}
					</div>
					{value.float_title && secondaryUrl && (
						<a class="home-hero__note" href={secondaryUrl}>
							{value.float_title}
							<span aria-hidden="true">→</span>
						</a>
					)}
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.home-hero :global(.home-hero__img) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 45%;
	}

	.home-hero .hero__media {
		position: relative;
		overflow: hidden;
		border-radius: var(--r-lg, 20px);
	}

	.home-hero .hero__over > :first-child {
		max-width: 760px;
	}

	.home-hero :global(h1) {
		max-width: 19ch;
		font-size: clamp(2.4rem, 4.4vw, 4rem);
		line-height: 1.03;
		text-wrap: balance;
	}

	.home-hero .hero__lead {
		max-width: 42ch;
		color: color-mix(in oklab, var(--p-inv-ink) 86%, var(--p-inv-bg));
	}

	.home-hero__facts {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.25rem;
		margin: 1.5rem 0 0;
		padding-top: 1.25rem;
		border-top: 1px solid color-mix(in oklab, var(--p-inv-ink) 16%, transparent);
		color: var(--p-inv-muted);
		font-size: 0.95rem;
	}

	.home-hero__facts span + span::before {
		content: "";
		display: inline-block;
		width: 4px;
		height: 4px;
		margin: 0 1.25rem 0.2em -0.625rem;
		border-radius: 50%;
		background: var(--p-accent);
		vertical-align: middle;
	}

	@media (max-width: 639px) {
		.home-hero__facts {
			flex-direction: column;
		}

		.home-hero__facts span + span::before {
			display: none;
		}
	}

	.home-hero__note {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		min-height: 44px;
		padding: 0.75rem 1.1rem;
		border-radius: var(--r-md, 12px);
		background: var(--p-inv-bg);
		color: var(--p-inv-ink);
		font-weight: 600;
		text-decoration: none;
	}

	.home-hero__note span {
		color: var(--p-accent);
	}
</style>
