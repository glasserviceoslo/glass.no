---
import { Image } from "emdash/ui";
import Arrow from "../Arrow.astro";
import { safeHref } from "../../utils/href";
import type { ImageValue } from "./surface";

interface Props {
	value: {
		kicker?: string;
		heading: string;
		lead?: string;
		primary_label?: string;
		primary_url?: string;
		secondary_label?: string;
		secondary_url?: string;
		image?: ImageValue;
		float_label?: string;
		float_title?: string;
	};
}

const { value } = Astro.props;
const primaryUrl = safeHref(value.primary_url);
const secondaryUrl = safeHref(value.secondary_url);
const hasFacts = Boolean(value.kicker || value.float_label || value.float_title);
---

<section class="hero home-hero" data-enter aria-labelledby="hero-h">
	<div class="wrap">
		<div class="home-hero__grid">
		<div class="home-hero__text">
			<h1 id="hero-h" data-enter-whole>{value.heading}</h1>
			{value.lead && <p class="home-hero__lead">{value.lead}</p>}
			<div class="btn-row">
				{value.primary_label && primaryUrl && (
					<a class="btn btn--primary" href={primaryUrl}>
						{value.primary_label}
						<Arrow />
					</a>
				)}
				{value.secondary_label && secondaryUrl && (
					<a class="btn btn--secondary" href={secondaryUrl}>
						{value.secondary_label}
					</a>
				)}
			</div>
		</div>
		{
			value.image && (
				<div class="home-hero__frame" data-enter-media>
					<Image image={value.image} alt={value.image.alt ?? ""} priority sizes="(max-width: 900px) 100vw, 620px" />
				</div>
			)
		}
		</div>
	</div>
	{
		hasFacts && (
			<div class="home-hero__rail">
				<div class="wrap">
				<dl class="home-hero__facts">
					{value.kicker && (
						<div>
							<dt>Glass.no</dt>
							<dd>{value.kicker}</dd>
						</div>
					)}
					{value.float_label && (
						<div>
							<dt>Åpent</dt>
							<dd>{value.float_label}</dd>
						</div>
					)}
					{value.float_title && (
						<div>
							<dt>Kampanje</dt>
							<dd>{secondaryUrl ? <a href={secondaryUrl}>{value.float_title}</a> : value.float_title}</dd>
						</div>
					)}
				</dl>
				</div>
			</div>
		)
	}
</section>

<style>
	.home-hero {
		height: auto;
		min-height: 0;
		padding: calc(var(--nav, 72px) + clamp(2rem, 4vw, 3.5rem)) 0 0;
		background: #ffffff;
		color: var(--p-ink);
	}

	.home-hero__grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: clamp(2rem, 5vw, 5rem);
		align-items: center;
		padding-bottom: clamp(2.5rem, 5vw, 4rem);
	}

	.home-hero__text {
		display: grid;
		gap: 1.5rem;
		justify-items: start;
	}

	.home-hero h1 {
		margin: 0;
		font-size: clamp(2.6rem, 5vw, 4.5rem);
		font-weight: 400;
		line-height: 1.03;
		letter-spacing: -0.035em;
		text-wrap: balance;
	}

	.home-hero__lead {
		max-width: 44ch;
		margin: 0;
		color: var(--p-muted);
		font-size: clamp(1.05rem, 1.3vw, 1.2rem);
		line-height: 1.6;
	}

	.home-hero .btn-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.home-hero__frame {
		overflow: hidden;
		border-radius: var(--radius, 20px);
		aspect-ratio: 5 / 4;
		background: var(--p-surface);
	}

	.home-hero__frame :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 30%;
	}

	.home-hero__rail {
		background: var(--p-bg);
		border-top: 1px solid color-mix(in oklab, var(--p-ink) 11%, transparent);
	}

	.home-hero__facts {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		margin-block: 0;
	}

	.home-hero__facts > div {
		padding: clamp(1.25rem, 2.5vw, 1.75rem) clamp(1rem, 2vw, 1.5rem);
	}

	.home-hero__facts > div + div {
		border-left: 1px solid color-mix(in oklab, currentColor 14%, transparent);
	}

	.home-hero__facts > div:first-child {
		padding-left: 0;
	}

	.home-hero__facts dt {
		margin-bottom: 0.25rem;
		color: var(--p-muted);
		font-size: 0.875rem;
	}

	.home-hero__facts dd {
		margin: 0;
		font-size: clamp(1.15rem, 1.6vw, 1.45rem);
		font-weight: 500;
		line-height: 1.3;
		letter-spacing: -0.01em;
	}

	.home-hero__facts a {
		color: var(--p-ink);
		text-decoration: none;
	}

	.home-hero__facts a:hover {
		text-decoration: underline;
		text-decoration-color: var(--p-accent);
		text-underline-offset: 0.2em;
	}

	@media (max-width: 900px) {
		.home-hero__grid,
		.home-hero__facts {
			grid-template-columns: minmax(0, 1fr);
		}

		.home-hero__facts > div {
			padding-left: 0;
		}

		.home-hero__facts > div + div {
			border-left: 0;
			border-top: 1px solid color-mix(in oklab, currentColor 14%, transparent);
		}
	}
</style>
