---
import RichText from "../RichText.astro";
import CallBandArt, { type ArtKind } from "./CallBandArt.astro";

interface Props {
	anchor?: string;
	lead: unknown[];
	body: unknown[];
}

const { anchor, lead, body } = Astro.props;
const slug = Astro.url.pathname.split("/").filter(Boolean).at(-1) ?? "";
const kinds: [RegExp, ArtKind][] = [
	[/velux|takvindu|flate-tak|overlys|solskjerming/, "roof"],
	[/vindu|kampanje/, "window"],
	[/dusj/, "shower"],
	[/smijern/, "steel"],
	[/rekkverk/, "railing"],
	[/glassvegg/, "partition"],
	[/vinterhage/, "glasshouse"],
	[/baldakin/, "canopy"],
	[/speil(?!glass)/, "mirror"],
	[/dor(-|$)/, "door"],
	[/glass|plexi|polykarbonat/, "pane"],
];
const kind = kinds.find(([pattern]) => pattern.test(slug))?.[1] ?? "window";
---

<section id={anchor || undefined} class="block section surface--brand call-band">
	<div class="container call-band__grid">
		<div>
			<RichText value={lead} class="call-band__lead" />
			<RichText value={body} class="call-band__body" />
		</div>
		<div class="call-band__art" aria-hidden="true">
			<CallBandArt kind={kind} />
		</div>
	</div>
</section>

<script>
	const arts = document.querySelectorAll<HTMLElement>(".call-band__art");
	if (arts.length && "IntersectionObserver" in window && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					const art = entry.target as HTMLElement;
					art.classList.add("is-drawn");
					requestAnimationFrame(() => art.classList.remove("is-waiting"));
					observer.unobserve(art);
				}
			},
			{ threshold: 0.5 },
		);
		arts.forEach((art) => {
			art.classList.add("is-waiting");
			observer.observe(art);
		});
	}
</script>

<style>
	.call-band {
		padding-block: clamp(2.75rem, 5vw, 4rem);
		overflow: hidden;
	}

	.call-band__grid {
		display: grid;
		grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
		gap: clamp(2.5rem, 6vw, 7rem);
		align-items: center;
	}

	.call-band__grid :global(.call-band__lead :is(h1, h2)) {
		margin: 0 0 1.25rem;
		font-size: var(--type-h2);
		line-height: 1.03;
		letter-spacing: -0.035em;
		text-wrap: balance;
	}

	.call-band__grid :global(.call-band__body > *) {
		max-width: 56ch;
	}

	.call-band__grid :global(.call-band__body p) {
		font-size: var(--type-reading);
		line-height: 1.7;
		text-wrap: pretty;
	}

	.call-band__art {
		position: relative;
		justify-self: end;
		width: min(100%, 30rem);
		aspect-ratio: 3 / 2;
	}

	.call-band__art :global(svg) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		overflow: visible;
	}

	.call-band__art :global(.call-band__line) {
		fill: none;
		stroke: #ffffff;
		stroke-width: 6;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-dasharray: 1;
		stroke-dashoffset: 0;
	}

	.call-band__art :global(.call-band__line--glint) {
		stroke-width: 4;
		opacity: 0.55;
	}

	.call-band__art.is-waiting :global(.call-band__line) {
		stroke-dashoffset: 1;
	}

	.call-band__art.is-drawn :global(.call-band__line) {
		transition: stroke-dashoffset 1.1s cubic-bezier(0.65, 0, 0.35, 1);
	}

	.call-band__art.is-drawn :global(.call-band__line:nth-child(2)) {
		transition-delay: 0.15s;
	}

	.call-band__art.is-drawn :global(.call-band__line:nth-child(3)),
	.call-band__art.is-drawn :global(.call-band__line:nth-child(4)) {
		transition-delay: 0.45s;
	}

	.call-band__art.is-drawn :global(.call-band__line:nth-child(n + 5)) {
		transition-delay: 0.75s;
	}

	@media (max-width: 1023px) {
		.call-band__grid {
			grid-template-columns: minmax(0, 1fr);
		}

		.call-band__art {
			display: none;
		}
	}
</style>
