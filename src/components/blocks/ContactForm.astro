---
import ContactFormFields from "../ContactFormFields.astro";
import RichText from "../RichText.astro";
import type { Surface } from "./surface";

interface Props {
	value: Surface & { _key?: string; heading?: string; intro?: string; aside?: unknown[] };
	blockKey?: string;
}

const { value, blockKey } = Astro.props;
---

<section data-block={value._key} class:list={["block", `surface--${value.background ?? "white"}`]}>
	<div class="container contact">
		{
			value.aside?.length ? (
				<>
					<RichText value={value.aside} class="contact__aside" />
					<div class="contact__form">
						{value.heading && <h2 class="contact__title" data-field="heading">{value.heading}</h2>}
						{value.intro && <p class="contact__intro" data-field="intro">{value.intro}</p>}
						<ContactFormFields id={`skjema-${blockKey ?? "kontakt"}`} />
					</div>
				</>
			) : (
				<>
					<div>
						{value.heading && <h2 data-field="heading">{value.heading}</h2>}
						{value.intro && <p class="contact__intro" data-field="intro">{value.intro}</p>}
					</div>
					<div class="contact__form">
						<ContactFormFields id={`skjema-${blockKey ?? "kontakt"}`} />
					</div>
				</>
			)
		}
	</div>
</section>

<style>
	.contact {
		display: grid;
		gap: clamp(1.5rem, 4vw, 3.5rem);
		grid-template-columns: 1fr 1.2fr;
		align-items: start;
	}

	.contact__form {
		display: grid;
		gap: 1rem;
		padding: clamp(1.25rem, 3vw, 2rem);
		border-radius: var(--radius);
		background: var(--white);
		box-shadow: var(--shadow);
		color: var(--flow-ink);
	}

	label {
		display: grid;
		gap: 0.35rem;
		font-weight: 600;
	}

	input,
	textarea {
		width: 100%;
		padding: 0.8rem 0.9rem;
		border: 1px solid var(--flow-line);
		border-radius: var(--radius-small);
		background: var(--paper);
		color: var(--flow-ink);
		font: inherit;
	}

	input:focus,
	textarea:focus {
		outline: 2px solid var(--p-ink);
		outline-offset: 1px;
	}

	.contact__title {
		margin: 0;
		font-size: var(--t-h3, 1.5rem);
	}

	.contact__form .btn {
		justify-self: start;
	}

	@media (max-width: 860px) {
		.contact {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
