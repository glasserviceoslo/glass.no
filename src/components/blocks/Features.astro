---
import { Image } from "emdash/ui";
import type { ImageValue } from "./surface";

interface Props {
	value: { _key?: string;
		background?: "white" | "light" | "tint" | "dark" | "brand";
		label?: string;
		heading: string;
		intro?: string;
		bullets?: string;
		image?: ImageValue;
		facts?: string;
		items?: { title: string; text?: string; icon?: ImageValue }[];
	};
}

const { value } = Astro.props;
const bullets = (value.bullets ?? "").split("\n").map((line) => line.trim()).filter(Boolean);
const facts = (value.facts ?? "")
	.split("\n")
	.map((line) => line.split("|").map((part) => part.trim()))
	.filter(([figure, label]) => figure && label);
const items = value.items ?? [];
---

<section data-block={value._key} class:list={["section", "features", value.background && `surface--${value.background}`]} id="hvorfor-oss" aria-labelledby="hvorfor-oss-h">
	<div class="wrap">
		<div class="features__grid">
			<div>
				{value.label && <p class="features__label" data-field="label">{value.label}</p>}
				<h2 id="hvorfor-oss-h" data-field="heading">{value.heading}</h2>
				{value.intro && <p class="features__intro" data-field="intro">{value.intro}</p>}
				{
					bullets.length > 0 && (
						<ul class="features__checks">
							{bullets.map((bullet) => (
								<li>
									<svg class="features__check" viewBox="0 0 20 20" aria-hidden="true">
										<circle cx="10" cy="10" r="10" />
										<path d="m6 10.2 2.6 2.6L14 7.4" />
									</svg>
									<span>{bullet}</span>
								</li>
							))}
						</ul>
					)
				}
			</div>
			{
				(value.image || facts.length > 0) && (
					<div class="features__media">
						{value.image && (
							<div class="features__photo">
								<Image image={value.image} alt={value.image.alt ?? ""} sizes="(max-width: 900px) 100vw, 640px" />
							</div>
						)}
						{facts.length > 0 && (
							<dl class="features__figs">
								{facts.map(([figure, label]) => (
									<div>
										<dt>{figure}</dt>
										<dd>{label}</dd>
									</div>
								))}
							</dl>
						)}
					</div>
				)
			}
		</div>
		{
			items.length > 0 && (
				<div class="grid features__cards">
					{items.map((item, index) => (
						<article class="card span-4 m-nolift">
							{item.icon && <Image image={item.icon} alt="" class="features__icon" width={56} height={56} />}
							<h3 data-field={`items.${index}.title`}>{item.title}</h3>
							{item.text && <p data-field={`items.${index}.text`}>{item.text}</p>}
						</article>
					))}
				</div>
			)
		}
	</div>
</section>

<style>
	.features {
		padding-block: clamp(3.5rem, 7vw, 6.5rem);
	}

	.features__grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
		gap: clamp(2.5rem, 6vw, 6rem);
		align-items: center;
	}

	.features h2 {
		margin: 0;
		font-size: clamp(2rem, 3.6vw, 3.25rem);
		font-weight: 400;
		line-height: 1.06;
		letter-spacing: -0.03em;
		text-wrap: balance;
	}

	.features__label {
		margin: 0 0 0.6rem;
		color: var(--p-muted);
		font-size: 0.875rem;
	}

	.features__intro {
		max-width: 46ch;
		margin: 1.25rem 0 0;
		color: var(--p-muted);
		font-size: clamp(1.05rem, 1.25vw, 1.15rem);
		line-height: 1.6;
	}

	.features__checks {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.9rem 1.5rem;
		margin: 2rem 0 0;
		padding: 0;
		list-style: none;
	}

	.features__checks li {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		font-size: 1.05rem;
		font-weight: 500;
	}

	.features__checks span::first-letter {
		text-transform: uppercase;
	}

	.features__check {
		flex: none;
		width: 1.4rem;
		height: 1.4rem;
	}

	.features__check circle {
		fill: var(--p-accent);
	}

	.features__check path {
		fill: none;
		stroke: #ffffff;
		stroke-width: 1.8;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.features__media {
		position: relative;
		padding-bottom: 3.5rem;
	}

	.features__photo {
		overflow: hidden;
		border-radius: 22px;
		aspect-ratio: 4 / 3;
		background: var(--p-surface);
	}

	.features__photo :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.features__figs {
		position: absolute;
		right: clamp(1rem, 3vw, 2rem);
		bottom: 0;
		left: clamp(1rem, 3vw, 2rem);
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem;
		margin: 0;
	}

	.features__figs > div {
		display: grid;
		gap: 0.35rem;
		padding: clamp(1rem, 2vw, 1.4rem) clamp(1.1rem, 2vw, 1.5rem);
		border-radius: 16px;
		color: #ffffff;
		box-shadow: 0 18px 36px -20px rgb(4 0 55 / 0.55);
	}

	.features__figs > div:first-child {
		background: var(--p-accent);
	}

	.features__figs > div:last-child {
		background: var(--p-ink);
	}

	.features__figs dt {
		font-size: clamp(2rem, 3.6vw, 3rem);
		font-weight: 400;
		line-height: 1;
		letter-spacing: -0.03em;
	}

	.features__figs dd {
		margin: 0;
		font-size: 0.8rem;
		font-weight: 500;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.features__cards {
		row-gap: clamp(1.75rem, 3vw, 2.75rem);
		margin-top: clamp(3rem, 6vw, 5rem);
	}

	.features__cards > :global(.card) {
		display: grid;
		grid-template-columns: 3.5rem minmax(0, 1fr);
		grid-template-rows: auto 1fr;
		column-gap: 1.25rem;
		align-content: start;
		padding: 0;
		border: 0;
		background: none;
		box-shadow: none;
	}

	.features__cards :global(.features__icon) {
		grid-row: 1 / 3;
		width: 3.5rem;
		height: auto;
		object-fit: contain;
	}

	.features__cards :global(.card h3) {
		margin: 0.15rem 0 0.35rem;
		font-family: var(--font-text), sans-serif;
		font-size: 1.125rem;
		font-weight: 600;
	}

	.features__cards :global(.card p) {
		margin: 0;
		color: var(--flow-muted, var(--p-muted));
		line-height: 1.5;
	}

	@media (max-width: 1023px) {
		.features__cards > :global(.card) {
			grid-column: span 6;
		}
	}

	@media (max-width: 900px) {
		.features__grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	@media (max-width: 639px) {
		.features__cards > :global(.card) {
			grid-column: 1 / -1;
		}
	}

	@media (max-width: 520px) {
		.features__checks {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
