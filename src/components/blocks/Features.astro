---
import { Image } from "emdash/ui";
import type { ImageValue } from "./surface";

interface Props {
	value: { background?: "white" | "light" | "tint" | "dark" | "brand"; 
		label?: string;
		heading: string;
		intro?: string;
		bullets?: string;
		image?: ImageValue;
		facts?: string;
		items?: { title: string; text?: string; icon?: ImageValue }[];
	};
}

const { value } = Astro.props;
const bullets = (value.bullets ?? "").split("\n").map((line) => line.trim()).filter(Boolean);
const facts = (value.facts ?? "")
	.split("\n")
	.map((line) => line.split("|").map((part) => part.trim()))
	.filter(([figure, label]) => figure && label);
const items = value.items ?? [];
---

<section class:list={["section", value.background && `surface--${value.background}`]} id="hvorfor-oss" aria-labelledby="hvorfor-oss-h">
	<div class="wrap">
		<div class="grid grid--top features__head">
			<div class="span-5 section-head">
				{value.label && <p class="t-label">{value.label}</p>}
				<h2 id="hvorfor-oss-h">{value.heading}</h2>
				{value.intro && <p>{value.intro}</p>}
			</div>
			<div class="span-6 start-7 stack-6">
				{value.image && (
					<div class="frame frame--photo features__photo">
						<Image image={value.image} alt={value.image.alt ?? ""} class="frame__img" sizes="(max-width: 1023px) 100vw, 640px" />
					</div>
				)}
				{bullets.length > 0 && (
					<ul class="features__list">
						{bullets.map((bullet) => (
							<li>{bullet}</li>
						))}
					</ul>
				)}
				{facts.length > 0 && (
					<dl class="features__facts">
						{facts.map(([figure, label]) => (
							<div>
								<dt class="t-stat">{figure}</dt>
								<dd class="t-small muted">{label}</dd>
							</div>
						))}
					</dl>
				)}
			</div>
		</div>
		{
			items.length > 0 && (
				<div class="grid features__cards">
					{items.map((item) => (
						<article class="card span-4 m-nolift">
							{item.icon && <Image image={item.icon} alt="" class="features__icon" width={56} height={56} />}
							<h3>{item.title}</h3>
							{item.text && <p>{item.text}</p>}
						</article>
					))}
				</div>
			)
		}
	</div>
</section>

<style>
	.features__head {
		margin-bottom: var(--s-8, 64px);
	}

	.features__photo {
		aspect-ratio: 4 / 3;
	}

	.features__list {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--s-3) var(--s-6);
		margin: 0;
		padding: 0;
		list-style: none;
		font-size: var(--t-lead);
	}

	.features__list li {
		padding-top: var(--s-3);
		border-top: 1px solid var(--line);
	}

	@media (max-width: 639px) {
		.features__list {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	.features__cards > :global(.card) {
		display: grid;
		grid-template-columns: 3.5rem minmax(0, 1fr);
		grid-template-rows: auto 1fr;
		column-gap: 1.25rem;
		align-content: start;
		padding: 0;
		border: 0;
		background: none;
		box-shadow: none;
	}

	.features__cards :global(.features__icon) {
		grid-row: 1 / 3;
		width: 3.5rem;
		height: auto;
		object-fit: contain;
	}

	.features__cards :global(.card h3) {
		margin: 0.15rem 0 0.35rem;
		font-family: var(--font-text), sans-serif;
		font-size: 1.125rem;
		font-weight: 600;
	}

	.features__cards :global(.card p) {
		margin: 0;
		color: var(--flow-muted, var(--p-muted));
		line-height: 1.5;
	}

	.features__facts {
		display: flex;
		gap: var(--s-7);
		margin: 0;
	}

	.features__facts dd {
		margin: 0;
	}

	.features__cards {
		row-gap: clamp(1.75rem, 3vw, 2.75rem);
	}

	@media (max-width: 1023px) {
		.features__cards > :global(.card) {
			grid-column: span 6;
		}
	}

	@media (max-width: 639px) {
		.features__cards > :global(.card) {
			grid-column: 1 / -1;
		}
	}
</style>
