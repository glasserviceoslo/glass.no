---
import { Image } from "emdash/ui";
import { contactHref, contactKind } from "../../utils/contact";
import { safeHref } from "../../utils/href";
import type { ImageValue, Surface } from "./surface";

type Card = { image?: ImageValue; title?: string; text?: string; url?: string; link_label?: string };

interface Props {
	value: Surface & { _key?: string; _entry?: string; heading?: string; columns?: string; style?: "image" | "icon"; items?: Card[] };
}

const { value } = Astro.props;
const items = (value.items ?? []).map((card) => ({ ...card, url: safeHref(card.url) }));
const style = value.style ?? "image";
const perRow = Number(value.columns ?? 3);
const columns = style === "icon" ? perRow : Math.min(perRow, 3);
const isContact = items.length > 0 && items.every((card) => !card.image && !card.url && card.title && card.text && card.text.length <= 60);
const isCatalogue = style === "image" && items.length > 1 && items.every((card) => card.image && card.url && /png|svg/.test(card.image.mimeType ?? card.image.src ?? ""));
const paragraphs = (text?: string) => (text ?? "").split(/\n\s*\n/).filter((paragraph) => paragraph.trim());
---

{isCatalogue ? (
<section data-block={value._key} data-entry={value._entry} class:list={["block", "catalogue", `surface--${value.background ?? "white"}`]}>
	<div class="container">
		{value.heading && <h2 class="block__heading" data-field="heading">{value.heading}</h2>}
		<ul class="catalogue__list" style={`--per-row: ${Math.min(perRow, 6)}`}>
			{items.map((card, index) => (
				<li>
					<a class="catalogue__item" href={card.url}>
						<span class="catalogue__media">
							<Image image={card.image!} alt="" sizes="(max-width: 560px) 50vw, (max-width: 1023px) 33vw, 240px" />
						</span>
						<span class="catalogue__title" data-field={`items.${index}.title`}>{card.title}</span>
						{card.link_label && (
							<span class="catalogue__more">
								{card.link_label}
								<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
							</span>
						)}
					</a>
				</li>
			))}
		</ul>
	</div>
</section>
) : isContact ? (
<section data-block={value._key} data-entry={value._entry} class:list={["block", "contact-strip", `surface--${value.background ?? "white"}`]}>
	<div class="container">
		{value.heading && <h2 class="block__heading" data-field="heading">{value.heading}</h2>}
		<dl class="contact-strip__list">
			{items.map((card, index) => {
				const kind = contactKind(card.text ?? "");
				const href = contactHref(card.text ?? "");
				return (
					<div class="contact-strip__item">
						<span class="contact-strip__icon" aria-hidden="true">
							{kind === "email" ? (
								<svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2.5" /><path d="m4 7 8 6 8-6" /></svg>
							) : kind === "phone" ? (
								<svg viewBox="0 0 24 24"><path d="M6.6 3.5h2.6l1.4 4-2 1.3a12 12 0 0 0 6.6 6.6l1.3-2 4 1.4v2.6a2 2 0 0 1-2.2 2A17 17 0 0 1 4.5 5.7a2 2 0 0 1 2.1-2.2Z" /></svg>
							) : (
								<svg viewBox="0 0 24 24"><path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z" /><circle cx="12" cy="10" r="2.4" /></svg>
							)}
						</span>
						<dt data-field={`items.${index}.title`}>{card.title}</dt>
						<dd>{href ? <a href={href} data-field={`items.${index}.text`}>{card.text}</a> : card.text}</dd>
					</div>
				);
			})}
		</dl>
	</div>
</section>
) : (
<section data-block={value._key} data-entry={value._entry} class:list={["block", `surface--${value.background ?? "white"}`]}>
	<div class="container">
		{value.heading && <h2 class="block__heading" data-field="heading">{value.heading}</h2>}
		<div class:list={["cards", `cards--${style}`]} style={`--per-row: ${columns}`}>
			{
				items.map((card, index) => (
					<article class:list={["card", { "m-nolift": !card.url }]}>
						{card.image && (
							<a href={card.url || undefined} class:list={["card__media", { "card__media--photo": style === "image" && !/png|svg/.test(card.image.mimeType ?? card.image.src ?? "") }]} tabindex="-1" aria-hidden="true">
								<Image image={card.image} class="card__image" sizes={style === "icon" ? "96px" : "(max-width: 860px) 100vw, 420px"} />
							</a>
						)}
						<div class="card__body">
							{card.title && (
								<h3 class="card__title">{card.url && !card.link_label ? <a href={card.url} data-field={`items.${index}.title`}>{card.title}</a> : card.title}</h3>
							)}
							{paragraphs(card.text).map((paragraph) => (
								<p class="card__text">{paragraph}</p>
							))}
							{card.url && card.link_label && (
								<a href={card.url} class="btn card__link">
									{card.link_label}
								</a>
							)}
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>
)}

<style>
	.catalogue__list {
		display: grid;
		grid-template-columns: repeat(var(--per-row), minmax(0, 1fr));
		gap: 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.catalogue__item {
		display: grid;
		gap: 0.35rem;
		height: 100%;
		padding: 0.75rem 0.75rem 1rem;
		border-radius: 20px;
		background: #ffffff;
		color: var(--p-ink);
		text-decoration: none;
		box-shadow: 0 1px 2px rgb(4 0 55 / 0.05);
		transition:
			box-shadow 250ms,
			translate 250ms cubic-bezier(0.16, 1, 0.3, 1);
	}

	:global(.surface--white) .catalogue__item {
		background: var(--p-bg);
	}

	.catalogue__media {
		display: grid;
		place-items: center;
		aspect-ratio: 1 / 1;
		margin-bottom: 0.5rem;
		overflow: hidden;
		border-radius: 14px;
		background: rgb(203 204 205 / 0.35);
	}

	.catalogue__media :global(img) {
		width: 100%;
		height: 100%;
		object-fit: contain;
		mix-blend-mode: multiply;
		transition: scale 600ms cubic-bezier(0.2, 0.8, 0.2, 1);
	}

	.catalogue__title {
		padding-inline: 0.25rem;
		font-size: var(--type-body);
		font-weight: 600;
		line-height: 1.3;
		text-transform: lowercase;
	}

	.catalogue__title::first-letter {
		text-transform: uppercase;
	}

	.catalogue__more {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		align-self: end;
		padding-inline: 0.25rem;
		color: var(--p-muted);
		font-size: var(--type-caption);
		font-weight: 500;
		transition: color 150ms;
	}

	.catalogue__more svg {
		width: 16px;
		height: 16px;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
		transition: translate 250ms cubic-bezier(0.16, 1, 0.3, 1);
	}

	.catalogue__item:hover {
		translate: 0 -2px;
		box-shadow: 0 18px 36px -20px rgb(4 0 55 / 0.35);
	}

	.catalogue__item:hover .catalogue__media :global(img) {
		scale: 1.04;
	}

	.catalogue__item:hover .catalogue__more {
		color: var(--p-accent);
	}

	.catalogue__item:hover .catalogue__more svg {
		translate: 3px 0;
	}

	@media (max-width: 1023px) {
		.catalogue__list {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	@media (max-width: 560px) {
		.catalogue__list {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 0.6rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.catalogue__item,
		.catalogue__media :global(img),
		.catalogue__more svg {
			transition: none;
		}
	}

	.contact-strip__list {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
		gap: 1.5rem clamp(1.5rem, 4vw, 3rem);
		margin: 0;
	}

	.contact-strip__item {
		display: grid;
		grid-template-columns: 3rem minmax(0, 1fr);
		grid-template-rows: auto auto;
		column-gap: 1rem;
		align-items: center;
	}

	.contact-strip__icon {
		grid-row: 1 / 3;
		display: grid;
		place-items: center;
		width: 3rem;
		height: 3rem;
		border-radius: 50%;
		background: var(--p-accent);
		color: var(--p-accent-ink, #fff);
	}

	.contact-strip__icon svg {
		width: 1.35rem;
		height: 1.35rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.8;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.contact-strip dt {
		align-self: end;
		font-weight: 600;
	}

	.contact-strip dd {
		align-self: start;
		margin: 0;
		color: var(--flow-muted);
	}

	.contact-strip dd a {
		color: inherit;
		text-decoration: none;
	}

	.contact-strip dd a:hover {
		color: var(--p-ink);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.cards {
		display: grid;
		gap: clamp(1rem, 2.5vw, 2rem);
		grid-template-columns: repeat(var(--per-row), minmax(0, 1fr));
	}

	.card {
		display: flex;
		flex-direction: column;
	}

	.cards--image .card {
		padding: 0;
		overflow: hidden;
		border-radius: var(--radius);
		background: var(--white);
		box-shadow: var(--shadow);
	}

	.cards--image .card__media {
		position: relative;
		display: block;
		overflow: hidden;
		aspect-ratio: 4 / 3;
		background: var(--paper);
	}

	.cards--image .card__media :global(img) {
		position: absolute;
		inset: 0;
		width: 100%;
		max-width: none;
		height: 100%;
		object-fit: contain;
	}

	.cards--image .card__media--photo :global(img) {
		object-fit: cover;
	}

	.cards--image .card__body {
		display: flex;
		flex: 1;
		flex-direction: column;
		align-items: flex-start;
		padding: 1.25rem 1.5rem 1.5rem;
	}

	.cards--image .card__title {
		font-family: var(--font-text), sans-serif;
		font-size: var(--type-title);
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: 0.02em;
	}

	.cards--image .card__link {
		margin-top: auto;
		padding: 0.6em 1.1em;
		font-size: var(--type-small);
	}

	.cards--icon {
		--per-row: 3 !important;
		row-gap: clamp(1.75rem, 3vw, 2.75rem);
		column-gap: clamp(1.5rem, 4vw, 4rem);
	}

	.cards--icon .card {
		display: grid;
		grid-template-columns: 3.5rem minmax(0, 1fr);
		column-gap: 1.25rem;
		align-items: start;
		padding: 0;
		border: 0;
		background: none;
		box-shadow: none;
	}

	.cards--icon .card__media {
		display: block;
		width: 3.5rem;
	}

	.cards--icon .card__media :global(img) {
		display: block;
		width: 100%;
		height: auto;
	}

	.cards--icon .card__title {
		margin: 0.15rem 0 0.35rem;
		font-family: var(--font-text), sans-serif;
		font-size: var(--type-title);
		font-weight: 600;
	}

	.cards--icon .card__text {
		margin: 0;
		color: var(--flow-muted);
		font-size: var(--type-body);
		line-height: 1.5;
	}

	.card__title a {
		color: inherit;
		text-decoration: none;
	}

	.card__text {
		margin-bottom: 1em;
	}

	@media (max-width: 1024px) {
		.cards {
			grid-template-columns: repeat(min(var(--per-row), 3), minmax(0, 1fr));
		}

		.cards--icon {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 720px) {
		.cards {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.cards--icon {
			grid-template-columns: minmax(0, 1fr);
		}

		.cards--image {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
