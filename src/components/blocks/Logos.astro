---
import { Image } from "emdash/ui";
import { safeHref } from "../../utils/href";
import type { ImageValue } from "./surface";

interface Props {
	value: { items?: { title: string; image?: ImageValue; url?: string }[] };
}

const { value } = Astro.props;
const items = (value.items ?? []).filter((item) => item.image).map((item) => ({ ...item, url: safeHref(item.url) }));
const copies = [false, true];
---

{
	items.length > 0 && (
		<div class="wrap logos">
			<div class="logos__track">
				{copies.map((hidden) => (
					<ul class="logos__list" aria-hidden={hidden ? "true" : undefined}>
						{items.map((item) => (
							<li class="logos__item">
								{item.url && !hidden ? (
									<a href={item.url}>
										<Image image={item.image!} alt={item.title} sizes="200px" />
									</a>
								) : (
									<Image image={item.image!} alt={hidden ? "" : item.title} sizes="200px" />
								)}
							</li>
						))}
					</ul>
				))}
			</div>
		</div>
	)
}

<style>
	.logos {
		overflow: hidden;
		padding-block: var(--s-6, 32px);
		mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
	}

	.logos__track {
		display: flex;
		width: max-content;
		animation: logos-scroll 40s linear infinite;
	}

	.logos:hover .logos__track,
	.logos:focus-within .logos__track {
		animation-play-state: paused;
	}

	.logos__list {
		display: flex;
		flex: none;
		align-items: center;
		gap: clamp(2.5rem, 5vw, 4.5rem);
		margin: 0;
		padding: 0 clamp(1.25rem, 2.5vw, 2.25rem);
		list-style: none;
	}

	.logos__item :global(img) {
		display: block;
		width: auto;
		height: clamp(36px, 4vw, 52px);
		max-width: 180px;
		object-fit: contain;
	}

	@keyframes logos-scroll {
		to {
			transform: translateX(-50%);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.logos {
			mask-image: none;
		}

		.logos__track {
			width: auto;
			animation: none;
		}

		.logos__list {
			flex-wrap: wrap;
			justify-content: center;
			row-gap: var(--s-4, 16px);
		}

		.logos__list[aria-hidden] {
			display: none;
		}
	}
</style>
