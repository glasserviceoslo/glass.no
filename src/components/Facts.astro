---
import { contactHref } from "../utils/contact";

interface Props {
	node: { items?: { label: string; value: string }[] };
}

const items = Astro.props.node.items ?? [];
---

{
	items.length > 0 && (
		<dl class="facts">
			{items.map((item) => {
				const href = contactHref(item.value);
				return (
					<div class="facts__item">
						<dt>{item.label}</dt>
						<dd>{href ? <a href={href}>{item.value}</a> : item.value}</dd>
					</div>
				);
			})}
		</dl>
	)
}

<style>
	.facts {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
		gap: 1rem 2rem;
		margin: 0.5rem 0 1.5rem;
		padding: 1.1rem 1.4rem;
		border-radius: var(--radius-small);
		background: var(--white, #fff);
		box-shadow: 0 1px 2px rgb(4 0 55 / 0.06), 0 8px 24px -12px rgb(4 0 55 / 0.12);
	}

	.facts dt {
		color: var(--flow-muted);
		font-size: 0.875rem;
	}

	.facts dd {
		margin: 0.15rem 0 0;
		color: var(--p-ink);
		font-size: 1.25rem;
		font-weight: 500;
		font-variant-numeric: tabular-nums;
	}

	.facts a {
		color: inherit;
		text-decoration: none;
	}

	.facts a:hover {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}
</style>
