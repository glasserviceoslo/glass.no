---
import type { MenuItem } from "emdash";
import { BOOKING_PATH } from "../utils/booking";

interface Props {
	items: MenuItem[];
	logo: { url: string; alt?: string | null; width?: number; height?: number } | null;
	siteTitle: string;
}

const { items, logo, siteTitle } = Astro.props;
const current = Astro.url.pathname;
const groupsOf = (item: MenuItem) => [
	...item.children.filter((child) => child.children.length),
	...(item.children.some((child) => !child.children.length) ? [{ id: `${item.id}-more`, label: "Mer", url: "", children: item.children.filter((child) => !child.children.length) } as MenuItem] : []),
];
---

<header class="nav nav--centre">
	<div class="wrap nav__bar">
		<a class="skip-link" href="#top">Hopp til innhold</a>
		<a class="nav__logo" href="/" aria-label={`${siteTitle}, forsiden`}>
			{logo ? <img class="nav__logo-img" src={logo.url} alt="" width={logo.width} height={logo.height} /> : siteTitle}
		</a>
		<nav class="nav__links" aria-label="Hovedmeny">
			{
				items.map((item) =>
					item.children.length ? (
						<div class="nav__item">
							<a class="nav__link" href={item.url || item.children[0]?.url}>
								{item.label}
								<svg class="chev" viewBox="0 0 12 12" aria-hidden="true">
									<path d="M3 4.5l3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
								</svg>
							</a>
							<div class="nav__menu">
								<div class="wrap grid">
									{groupsOf(item).map((group) => (
										<div class="menu-col span-3">
											{group.url ? (
												<a class="t-label" href={group.url}>
													{group.label}
												</a>
											) : (
												<p class="t-label">{group.label}</p>
											)}
											{group.children.map((child) => (
												<a href={child.url} aria-current={child.url === current ? "page" : undefined}>
													{child.label}
												</a>
											))}
										</div>
									))}
								</div>
							</div>
						</div>
					) : (
						<div class="nav__item">
							<a class="nav__link" href={item.url} aria-current={item.url === current ? "page" : undefined}>
								{item.label}
							</a>
						</div>
					),
				)
			}
		</nav>
		<div class="nav__actions">
			<a class="btn btn--primary" href={BOOKING_PATH}>Gratis Befaring</a>
		</div>
		<button class="nav__toggle" type="button" aria-expanded="false" aria-label="Meny">
			<svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M2 5h14M2 13h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg>
		</button>
	</div>
</header>

<style>
	.nav__logo-img {
		display: block;
		width: auto;
		height: 32px;
	}
</style>
