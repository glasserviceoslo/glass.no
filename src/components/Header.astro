---
import type { MenuItem } from "emdash";
import { BOOKING_PATH } from "../utils/booking";

interface Props {
	items: MenuItem[];
	logo: { url: string; alt?: string | null; width?: number; height?: number } | null;
	siteTitle: string;
}

const { items, logo, siteTitle } = Astro.props;
const current = Astro.url.pathname;
const groupsOf = (item: MenuItem) => [
	...item.children.filter((child) => child.children.length),
	...(item.children.some((child) => !child.children.length) ? [{ id: `${item.id}-more`, label: "Mer", url: "", children: item.children.filter((child) => !child.children.length) } as MenuItem] : []),
];
const trim = (url: string) => url.replace(/\/+$/, "") || "/";
const here = trim(current);
const urlsOf = (item: MenuItem): string[] => [item.url, ...item.children.flatMap(urlsOf)].filter(Boolean).map(trim);
const home = items.find((item) => !item.children.length);
const products = items.find((item) => item.children.length);
const contact = items.find((item) => !item.children.length && item !== home && /kontakt/i.test(item.url));
const more = items.filter((item) => !item.children.length && item !== home && item !== contact);
const homeActive = home && (here === "/" || here === trim(home.url));
const productsActive = products && products.children.flatMap(urlsOf).includes(here);
const contactActive = contact && here === trim(contact.url);
const moreActive = more.some((item) => here === trim(item.url));
---

<header class="nav nav--centre">
	<div class="wrap nav__bar">
		<a class="skip-link" href="#top">Hopp til innhold</a>
		<a class="nav__logo" href="/" aria-label={`${siteTitle}, forsiden`}>
			{logo ? <img class="nav__logo-img" src={logo.url} alt="" width={logo.width} height={logo.height} /> : siteTitle}
		</a>
		<nav class="nav__links" aria-label="Hovedmeny">
			{
				items.map((item) =>
					item.children.length ? (
						<div class="nav__item">
							<a class="nav__link" href={item.url || item.children[0]?.url}>
								{item.label}
								<svg class="chev" viewBox="0 0 12 12" aria-hidden="true">
									<path d="M3 4.5l3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
								</svg>
							</a>
							<div class="nav__menu">
								<div class="wrap">
									<div class="products">
										<ul class="products__list">
											{groupsOf(item).map((group, index) => (
												<li class:list={["products__cat", { "is-active": index === 0 }]}>
													{group.url ? (
														<a class="products__name" href={group.url}>
															{group.label}
														</a>
													) : (
														<span class="products__name" tabindex="0">
															{group.label}
														</span>
													)}
													<ul class="products__sub">
														{group.children.map((child) => (
															<li>
																<a href={child.url} aria-current={child.url === current ? "page" : undefined}>
																	{child.label}
																</a>
															</li>
														))}
													</ul>
												</li>
											))}
										</ul>
									</div>
								</div>
							</div>
						</div>
					) : (
						<div class="nav__item">
							<a class="nav__link" href={item.url} aria-current={item.url === current ? "page" : undefined}>
								{item.label}
							</a>
						</div>
					),
				)
			}
		</nav>
		<div class="nav__actions">
			<button class="nav__search" type="button" data-search-open aria-label="Søk" aria-keyshortcuts="Meta+K Control+K">
				<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="m16 16 4 4" /></svg>
			</button>
			<a class="btn btn--primary" href={BOOKING_PATH}>Gratis Befaring</a>
		</div>
	</div>
</header>

<nav class="tabbar" aria-label="Meny">
	{
		home && (
			<a class="tabbar__tab" href={home.url} aria-current={homeActive ? "page" : undefined}>
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 10.5 12 4l8 6.5V19a1 1 0 0 1-1 1h-4.5v-5.5h-5V20H5a1 1 0 0 1-1-1Z" /></svg>
				<span>{home.label}</span>
			</a>
		)
	}
	{
		products && (
			<button class="tabbar__tab" type="button" data-sheet="sheet-products" aria-haspopup="dialog" aria-current={productsActive ? "page" : undefined}>
				<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="6.5" height="6.5" rx="1.8" /><rect x="13.5" y="4" width="6.5" height="6.5" rx="1.8" /><rect x="4" y="13.5" width="6.5" height="6.5" rx="1.8" /><rect x="13.5" y="13.5" width="6.5" height="6.5" rx="1.8" /></svg>
				<span>{products.label}</span>
			</button>
		)
	}
	<a class="tabbar__cta" href={BOOKING_PATH}>Gratis Befaring</a>
	{
		contact && (
			<a class="tabbar__tab" href={contact.url} aria-current={contactActive ? "page" : undefined}>
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.5 6.5A2.5 2.5 0 0 1 7 4h10a2.5 2.5 0 0 1 2.5 2.5v7A2.5 2.5 0 0 1 17 16h-6.5L6 19.5V16h0A1.5 1.5 0 0 1 4.5 14.5Z" /></svg>
				<span>{contact.label}</span>
			</a>
		)
	}
	<button class="tabbar__tab" type="button" data-sheet="sheet-more" aria-haspopup="dialog" aria-current={moreActive ? "page" : undefined}>
		<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="6" cy="12" r="1.6" /><circle cx="12" cy="12" r="1.6" /><circle cx="18" cy="12" r="1.6" /></svg>
		<span>Mer</span>
	</button>
</nav>

{
	products && (
		<dialog class="sheet" id="sheet-products" aria-labelledby="sheet-products-title">
			<div class="sheet__grab" data-sheet-drag>
				<span />
			</div>
			<section class="sheet__view" data-view="root">
				<header class="sheet__head" data-sheet-drag>
					<h2 id="sheet-products-title">{products.label}</h2>
					<button class="sheet__close" type="button" aria-label="Lukk" data-sheet-close>
						<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7 7 10 10M17 7 7 17" /></svg>
					</button>
				</header>
				<ul class="sheet__list">
					{groupsOf(products).map((group, index) => (
						<li>
							<button class="sheet__row" type="button" data-open-view={`group-${index}`}>
								{group.label}
								<svg class="sheet__chev" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg>
							</button>
						</li>
					))}
				</ul>
			</section>
			{groupsOf(products).map((group, index) => (
				<section class="sheet__view" data-view={`group-${index}`} hidden>
					<header class="sheet__head" data-sheet-drag>
						<button class="sheet__back" type="button" data-open-view="root">
							<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 6-6 6 6 6" /></svg>
							{products.label}
						</button>
						<button class="sheet__close" type="button" aria-label="Lukk" data-sheet-close>
							<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7 7 10 10M17 7 7 17" /></svg>
						</button>
					</header>
					{group.url ? (
						<a class="sheet__title" href={group.url}>
							{group.label}
							<svg class="sheet__chev" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg>
						</a>
					) : (
						<p class="sheet__title">{group.label}</p>
					)}
					<ul class="sheet__list">
						{group.children.map((child) => (
							<li>
								<a class="sheet__row" href={child.url} aria-current={trim(child.url) === here ? "page" : undefined}>
									{child.label}
									<svg class="sheet__chev" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg>
								</a>
							</li>
						))}
					</ul>
				</section>
			))}
		</dialog>
	)
}

<dialog class="sheet" id="sheet-more" aria-labelledby="sheet-more-title">
	<div class="sheet__grab" data-sheet-drag>
		<span />
	</div>
	<section class="sheet__view" data-view="root">
		<header class="sheet__head" data-sheet-drag>
			<h2 id="sheet-more-title">Mer</h2>
			<button class="sheet__close" type="button" aria-label="Lukk" data-sheet-close>
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7 7 10 10M17 7 7 17" /></svg>
			</button>
		</header>
		<button class="sheet__searchrow" type="button" data-search-open>
			<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="m16 16 4 4" /></svg>
			Søk
		</button>
		<ul class="sheet__list">
			{
				more.map((item) => (
					<li>
						<a class="sheet__row" href={item.url} aria-current={trim(item.url) === here ? "page" : undefined}>
							{item.label}
							<svg class="sheet__chev" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg>
						</a>
					</li>
				))
			}
		</ul>
		<ul class="sheet__list">
			<li>
				<a class="sheet__row" href="tel:+4791584940">+47 91 58 49 40</a>
			</li>
			<li>
				<a class="sheet__row" href="https://www.google.com/maps/search/?api=1&query=Pilestredet%2041A%2C%20Oslo" target="_blank" rel="noopener">Pilestredet 41A</a>
			</li>
			<li>
				<p class="sheet__row sheet__row--plain">Man - Fre 08:00-17:00</p>
			</li>
		</ul>
	</section>
</dialog>

<dialog class="search" aria-label="Søk">
	<div class="search__field">
		<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="m16 16 4 4" /></svg>
		<input type="search" placeholder="Søk" aria-label="Søk på glass.no" autocomplete="off" enterkeyhint="search" />
		<button class="search__close" type="button" aria-label="Lukk" data-search-close>
			<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7 7 10 10M17 7 7 17" /></svg>
		</button>
	</div>
	<ul class="search__results" role="listbox" aria-label="Treff"></ul>
	<p class="search__empty" role="status" hidden>Ingen treff</p>
</dialog>

<script>
	const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");

	const showView = (sheet: HTMLDialogElement, name: string) => {
		sheet.querySelectorAll<HTMLElement>("[data-view]").forEach((view) => {
			const active = view.dataset.view === name;
			view.hidden = !active;
			view.classList.toggle("is-entering", active && name !== "root");
		});
		const view = sheet.querySelector<HTMLElement>(`[data-view="${name}"]`);
		view?.querySelector<HTMLElement>(name === "root" ? ".sheet__row" : ".sheet__back")?.focus({ preventScroll: true });
		sheet.scrollTop = 0;
	};

	document.querySelectorAll<HTMLButtonElement>("[data-sheet]").forEach((button) => {
		button.addEventListener("click", () => document.querySelector<HTMLDialogElement>(`#${button.dataset.sheet}`)?.showModal());
	});

	document.querySelectorAll<HTMLDialogElement>("dialog.sheet").forEach((sheet) => {
		sheet.addEventListener("click", (event) => {
			const target = event.target as HTMLElement;
			const box = sheet.getBoundingClientRect();
			const outside = event.clientY < box.top || event.clientX < box.left || event.clientX > box.right;
			if (outside || target.closest("[data-sheet-close]")) sheet.close();
			const opener = target.closest<HTMLElement>("[data-open-view]");
			if (opener) showView(sheet, opener.dataset.openView!);
		});

		sheet.addEventListener("close", () => {
			sheet.style.translate = "";
			if (sheet.querySelector("[data-view]:not([data-view='root']):not([hidden])")) setTimeout(() => showView(sheet, "root"), 400);
		});

		let startY = 0;
		let dragging = false;
		sheet.querySelectorAll<HTMLElement>("[data-sheet-drag]").forEach((handle) => {
			handle.addEventListener("pointerdown", (event) => {
				if ((event.target as HTMLElement).closest("button, a")) return;
				dragging = true;
				startY = event.clientY;
				sheet.classList.add("is-dragging");
				handle.setPointerCapture(event.pointerId);
			});
			handle.addEventListener("pointermove", (event) => {
				if (!dragging) return;
				sheet.style.translate = `0 ${Math.max(0, event.clientY - startY)}px`;
			});
			const release = (event: PointerEvent) => {
				if (!dragging) return;
				dragging = false;
				sheet.classList.remove("is-dragging");
				const distance = event.clientY - startY;
				sheet.style.translate = "";
				if (distance > 90 || (reduced.matches && distance > 40)) sheet.close();
			};
			handle.addEventListener("pointerup", release);
			handle.addEventListener("pointercancel", release);
		});
	});

	document.querySelectorAll<HTMLElement>(".products__list").forEach((list) => {
		let timer = 0;
		const activate = (category: Element) => {
			list.querySelectorAll(".products__cat.is-active").forEach((item) => item.classList.remove("is-active"));
			category.classList.add("is-active");
		};
		list.querySelectorAll<HTMLElement>(".products__cat").forEach((category) => {
			const name = category.querySelector<HTMLElement>(".products__name")!;
			name.addEventListener("pointerenter", () => {
				clearTimeout(timer);
				timer = window.setTimeout(() => activate(category), 100);
			});
			name.addEventListener("pointerleave", () => clearTimeout(timer));
			category.addEventListener("focusin", () => activate(category));
		});
	});

	const search = document.querySelector<HTMLDialogElement>("dialog.search")!;
	const query = search.querySelector("input")!;
	const results = search.querySelector<HTMLUListElement>(".search__results")!;
	const empty = search.querySelector<HTMLElement>(".search__empty")!;
	let timer = 0;
	let pending: AbortController | undefined;
	let active = -1;

	const options = () => [...results.querySelectorAll<HTMLAnchorElement>("a")];
	const highlight = (index: number) => {
		const list = options();
		active = list.length ? (index + list.length) % list.length : -1;
		list.forEach((option, position) => option.setAttribute("aria-selected", String(position === active)));
		list[active]?.scrollIntoView({ block: "nearest" });
	};

	const openSearch = () => {
		document.querySelectorAll<HTMLDialogElement>("dialog.sheet[open]").forEach((sheet) => sheet.close());
		search.showModal();
		query.select();
	};

	const run = async () => {
		const text = query.value.trim();
		pending?.abort();
		if (text.length < 2) {
			results.replaceChildren();
			empty.hidden = true;
			return;
		}
		pending = new AbortController();
		try {
			const response = await fetch(`/_emdash/api/search?${new URLSearchParams({ q: text, limit: "8" })}`, { signal: pending.signal });
			const { data } = (await response.json()) as { data: { items: { collection: string; slug: string; title: string; snippet?: string }[] } };
			results.replaceChildren(
				...data.items.map((item) => {
					const li = document.createElement("li");
					const link = document.createElement("a");
					link.className = "search__result";
					link.href = `/${item.slug}/`;
					link.setAttribute("role", "option");
					const title = document.createElement("span");
					title.className = "search__title";
					title.textContent = item.title;
					link.append(title);
					if (item.snippet && item.snippet.replace(/<[^>]+>/g, "").trim() !== item.title.trim()) {
						const snippet = document.createElement("span");
						snippet.className = "search__snippet";
						snippet.innerHTML = item.snippet;
						link.append(snippet);
					}
					if (item.collection === "posts") {
						const tag = document.createElement("span");
						tag.className = "search__tag";
						tag.textContent = "Blogg";
						link.append(tag);
					}
					li.append(link);
					return li;
				}),
			);
			empty.hidden = data.items.length > 0;
			highlight(0);
		} catch (error) {
			if ((error as Error).name !== "AbortError") empty.hidden = false;
		}
	};

	query.addEventListener("input", () => {
		clearTimeout(timer);
		timer = window.setTimeout(run, 180);
	});

	query.addEventListener("keydown", (event) => {
		if (event.key === "ArrowDown" || event.key === "ArrowUp") {
			event.preventDefault();
			highlight(active + (event.key === "ArrowDown" ? 1 : -1));
		}
		if (event.key === "Enter" && options()[active]) {
			event.preventDefault();
			options()[active].click();
		}
	});

	document.querySelectorAll("[data-search-open]").forEach((button) => button.addEventListener("click", openSearch));
	search.addEventListener("click", (event) => {
		const target = event.target as HTMLElement;
		const box = search.getBoundingClientRect();
		const outside = event.clientY < box.top || event.clientY > box.bottom || event.clientX < box.left || event.clientX > box.right;
		if (outside || target.closest("[data-search-close]")) search.close();
	});
	document.addEventListener("keydown", (event) => {
		if (event.key.toLowerCase() === "k" && (event.metaKey || event.ctrlKey)) {
			event.preventDefault();
			if (search.open) search.close();
			else openSearch();
		}
	});

	window.matchMedia("(min-width: 1024px)").addEventListener("change", (event) => {
		if (event.matches) document.querySelectorAll<HTMLDialogElement>("dialog.sheet[open]").forEach((sheet) => sheet.close());
	});
</script>

<style>
	.nav {
		top: 12px;
		height: 60px;
		border: 0;
		background: transparent;
		box-shadow: none;
		pointer-events: none;
	}

	.nav__bar {
		position: relative;
		isolation: isolate;
		padding: 0 8px 0 24px;
		border-radius: 999px;
		pointer-events: auto;
	}

	.nav__bar::before {
		content: "";
		position: absolute;
		inset: 0;
		z-index: -1;
		border: 1px solid rgb(255 255 255 / 0.75);
		border-radius: inherit;
		background: linear-gradient(160deg, rgb(255 255 255 / 0.72), rgb(255 255 255 / 0.45));
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 0.95),
			0 18px 40px -22px rgb(4 0 55 / 0.4),
			0 2px 6px -2px rgb(4 0 55 / 0.08);
		-webkit-backdrop-filter: blur(22px) saturate(190%);
		backdrop-filter: blur(22px) saturate(190%);
	}

	.nav__logo-img {
		display: block;
		width: auto;
		height: 32px;
	}

	.nav__links {
		justify-content: center;
	}

	.nav__link {
		font-weight: 500;
	}

	.nav__link::before,
	.nav__link[aria-current="page"]::after {
		background: var(--p-accent);
	}

	.nav__actions .btn {
		height: 44px;
		border-radius: 999px;
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 0.35),
			0 8px 18px -10px rgb(237 76 76 / 0.8);
	}

	.nav__menu {
		top: calc(100% + 10px);
		right: auto;
		left: 50%;
		width: min(46rem, 100%);
		translate: -50% 0;
		padding: 0;
		border: 0;
		background: none;
		box-shadow: none;
	}

	.nav__menu::before {
		content: "";
		position: absolute;
		top: -12px;
		right: 0;
		left: 0;
		height: 12px;
	}

	.nav__menu > .wrap {
		width: 100%;
		max-width: none;
		margin: 0;
		padding: 0;
	}

	.products {
		position: relative;
		min-height: 23rem;
		padding: 0.9rem;
		border: 1px solid rgb(255 255 255 / 0.7);
		border-radius: 28px;
		background: linear-gradient(160deg, rgb(255 255 255 / 0.78), rgb(255 255 255 / 0.5));
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 0.95),
			0 40px 80px -40px rgb(4 0 55 / 0.45),
			0 2px 8px -2px rgb(4 0 55 / 0.08);
		-webkit-backdrop-filter: blur(28px) saturate(190%);
		backdrop-filter: blur(28px) saturate(190%);
	}

	.products ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.products__list {
		display: grid;
		align-content: start;
		gap: 2px;
		width: 13rem;
	}

	.products__name {
		display: flex;
		align-items: center;
		min-height: 42px;
		padding: 0 1rem;
		border-radius: 14px;
		color: var(--muted);
		font-size: 1rem;
		font-weight: 500;
		cursor: pointer;
		transition:
			background-color 180ms,
			color 180ms,
			box-shadow 180ms;
	}

	.products__sub {
		position: absolute;
		top: 1.5rem;
		right: 1.75rem;
		left: 16rem;
		display: none;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0 1.75rem;
	}

	.products__sub a {
		display: flex;
		align-items: center;
		min-height: 54px;
		border-bottom: 1px solid rgb(4 0 55 / 0.08);
		color: var(--ink);
		font-size: 1.05rem;
		font-weight: 500;
		line-height: 1.3;
		transition: color 150ms;
	}

	.products__sub a::first-letter {
		text-transform: uppercase;
	}

	.products__sub a:hover {
		color: var(--p-accent);
	}

	.products__cat.is-active > .products__name {
		background: rgb(255 255 255 / 0.85);
		color: var(--ink);
		box-shadow:
			inset 0 1px 0 #ffffff,
			0 6px 16px -8px rgb(4 0 55 / 0.3),
			inset 3px 0 0 var(--p-accent);
	}

	.products__cat.is-active > .products__sub {
		display: grid;
	}

	.tabbar {
		display: none;
	}

	.nav__search {
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		padding: 0;
		border: 0;
		border-radius: 999px;
		background: rgb(4 0 55 / 0.05);
		color: var(--p-ink);
		cursor: pointer;
		transition:
			background-color 150ms,
			scale 150ms;
	}

	.nav__search:hover {
		background: rgb(4 0 55 / 0.09);
