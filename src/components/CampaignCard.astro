---
import { Image } from "emdash/ui";
import Arrow from "./Arrow.astro";
import { safeHref } from "../utils/href";
import type { ImageValue } from "./blocks/surface";

interface Props {
	value: {
		label?: string;
		figure?: string;
		heading: string;
		text?: string;
		note?: string;
		cta_label?: string;
		cta_url?: string;
		image?: ImageValue;
	};
}

const { value } = Astro.props;
const ctaUrl = safeHref(value.cta_url);
const posterLed = Boolean(value.image);
---

<aside class:list={["campaign-card", { "campaign-card--poster": posterLed }]} aria-labelledby="kampanje-h" id="kampanje" data-enter-media>
	{
		posterLed ? (
			<>
				<h2 id="kampanje-h" class="campaign-card__hidden">{value.heading}</h2>
				<a class="campaign-card__poster" href={ctaUrl ?? "/kampanje/"} tabindex="-1">
					<Image image={value.image!} alt={value.image!.alt ?? value.heading} priority sizes="(max-width: 900px) 100vw, 620px" />
				</a>
			</>
		) : (
			<div class="campaign-card__copy">
				{value.label && <p class="campaign-card__label">{value.label}</p>}
				{value.figure && <p class="campaign-card__figure" aria-hidden="true">{value.figure}</p>}
				<h2 id="kampanje-h">{value.heading}</h2>
				{value.text && <p class="campaign-card__text">{value.text}</p>}
			</div>
		)
	}
	{
		(value.note || (value.cta_label && ctaUrl)) && (
			<div class="campaign-card__bar">
				{value.note && (
					<p class="campaign-card__note">
						<svg viewBox="0 0 24 24" aria-hidden="true">
							<circle cx="12" cy="12" r="8.5" />
							<path d="M12 7.5V12l3 2" />
						</svg>
						{value.note}
					</p>
				)}
				{value.cta_label && ctaUrl && (
					<a class="btn btn--primary campaign-card__cta" href={ctaUrl}>
						{value.cta_label}
						<Arrow />
					</a>
				)}
			</div>
		)
	}
</aside>

<style>
	.campaign-card {
		display: grid;
		overflow: hidden;
		border-radius: 28px;
		background: var(--p-ink);
		color: #f8f9fa;
		box-shadow: 0 40px 80px -40px rgb(4 0 55 / 0.65);
	}

	.campaign-card--poster {
		justify-self: end;
		width: min(100%, 36rem);
	}

	.campaign-card__hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	.campaign-card__poster {
		display: block;
		overflow: hidden;
		aspect-ratio: 1 / 1;
	}

	.campaign-card__poster :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: scale 700ms cubic-bezier(0.2, 0.8, 0.2, 1);
	}

	.campaign-card__poster:hover :global(img) {
		scale: 1.03;
	}

	.campaign-card__copy {
		display: grid;
		justify-items: start;
		gap: 0.75rem;
		padding: clamp(1.5rem, 2.6vw, 2.25rem);
	}

	.campaign-card__label {
		margin: 0;
		padding: 0.35rem 0.8rem;
		border-radius: 999px;
		background: var(--p-action);
		color: #ffffff;
		font-size: var(--type-label);
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.campaign-card__figure {
		margin: 0.1rem 0 -0.35rem;
		color: var(--p-accent);
		font-size: clamp(3.75rem, 6.4vw, 6rem);
		font-weight: 700;
		line-height: 0.85;
		letter-spacing: -0.05em;
	}

	.campaign-card__copy h2 {
		margin: 0;
		color: #ffffff;
		font-size: var(--type-h3);
		font-weight: 500;
		line-height: 1.08;
		letter-spacing: -0.025em;
		text-wrap: balance;
	}

	.campaign-card__text {
		margin: 0;
		color: color-mix(in oklab, #f8f9fa 78%, var(--p-ink));
		font-size: var(--type-small);
		line-height: 1.5;
	}

	.campaign-card__bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem 1.25rem;
		padding: clamp(1rem, 2vw, 1.25rem) clamp(1.25rem, 2.4vw, 1.75rem);
	}

	.campaign-card__note {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin: 0;
		color: #ffffff;
		font-size: var(--type-body);
		font-weight: 600;
	}

	.campaign-card__note svg {
		width: 1.25rem;
		height: 1.25rem;
		fill: none;
		stroke: var(--p-accent);
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.campaign-card__cta {
		font-weight: 600;
	}

	@media (max-width: 900px) {
		.campaign-card--poster {
			justify-self: stretch;
			width: 100%;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.campaign-card__poster :global(img) {
			transition: none;
		}
	}
</style>
