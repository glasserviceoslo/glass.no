---
interface Props {
	node: { items?: { icon: string; href: string }[] };
}

const { node } = Astro.props;
const names: Record<string, string> = { "facebook-f": "Facebook", facebook: "Facebook", instagram: "Instagram" };
const items = (node.items ?? []).filter((item) => /^https:\/\//.test(item.href));
---

{
	items.length > 0 && (
		<ul class="icons" role="list">
			{items.map((item) => (
				<li>
					<a class="icons__link" href={item.href} rel="noopener" target="_blank" aria-label={names[item.icon] ?? new URL(item.href).hostname}>
						{item.icon.startsWith("facebook") ? (
							<svg viewBox="0 0 24 24" aria-hidden="true">
								<path d="M13.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.5-1.5h1.6V4.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.8 1.4-3.8 3.9v2.3H7.9v3h2.6V21z" fill="currentColor" />
							</svg>
						) : item.icon === "instagram" ? (
							<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8">
								<rect x="3.5" y="3.5" width="17" height="17" rx="5" />
								<circle cx="12" cy="12" r="4" />
								<circle cx="17.3" cy="6.7" r="0.6" fill="currentColor" stroke="none" />
							</svg>
						) : (
							<span>{names[item.icon] ?? new URL(item.href).hostname}</span>
						)}
					</a>
				</li>
			))}
		</ul>
	)
}

<style>
	.icons {
		display: flex;
		gap: 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.icons__link {
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 50%;
		background: var(--p-surface, #f1f2f5);
		color: var(--p-accent, #ed4c4c);
		transition: transform 160ms ease, background-color 160ms ease;
	}

	.icons__link:hover {
		transform: translateY(-2px);
	}

	.icons__link svg {
		width: 1.25rem;
		height: 1.25rem;
	}
</style>
