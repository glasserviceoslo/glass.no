---
import Base from "../layouts/Base.astro";

Astro.response.status = 404;
---

<Base title="Fant ikke siden" robots="noindex">
	<section class="block surface--white">
		<div class="container not-found">
			<p class="not-found__code">404</p>
			<h1>Fant ikke siden</h1>
			<p>Siden du leter etter finnes ikke, eller den er flyttet.</p>
			<p>
				<a href="/" class="btn btn--large">Til forsiden</a>
				<a href="/kontakt-oss/" class="btn btn--secondary btn--large">Kontakt oss</a>
			</p>
		</div>
	</section>
</Base>

<style>
	.not-found {
		text-align: center;
	}

	.not-found__code {
		margin: 0;
		color: var(--red);
		font-family: var(--font-display), serif;
		font-size: clamp(6rem, 18vw, 11rem);
		line-height: 1;
	}

	.not-found .btn {
		margin: 0.4rem;
	}
</style>
